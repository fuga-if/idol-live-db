<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 通知は Android 13+ でランタイム権限。設定画面の「通知を許可する」から要求する。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AlarmManager の予約は端末の再起動で全部消えるので、起動完了を受けて積み直す。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM は意図的に宣言しない。
      誕生日 9:00・日曜 20:00 といった通知は数分ずれても価値が落ちない一方、
      exact alarm はユーザーによる個別許可 (12+) を必要とし、USE_EXACT_ALARM は
      「アラーム/カレンダーが主目的のアプリ」限定という Play のポリシーがある。
      代わりに setAndAllowWhileIdle を使う (権限不要・Doze でも発火・数分の誤差)。
      詳細は NotificationScheduler の KDoc。
    -->

    <application
        android:name=".ImasLiveDBApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ImasLiveDB"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ImasLiveDB"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          シェアカード画像の受け渡し口。
          cacheDir に書いた PNG はアプリ専用領域なので他アプリからは読めず、file:// で渡すと
          Android 7 以降 FileUriExposedException で落ちる。FileProvider を挟んで content:// に
          化かし、ACTION_SEND の受け手へ一時的な読み取り権限だけを渡す。
          公開範囲は res/xml/provider_paths.xml の cache-path 1 つに限定 (exported は false)。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shareprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <!-- 予約時刻に叩かれて通知を 1 本出す。自アプリの AlarmManager からしか来ない。 -->
        <receiver
            android:name=".data.notification.NotificationAlarmReceiver"
            android:exported="false" />

        <!--
          予約が消える/ずれる出来事のあとに積み直す。
          exported="false" のままで届く: システム (uid=SYSTEM) が送るブロードキャストは
          非 exported なレシーバにも配送される (WorkManager の RescheduleReceiver と同じ形)。
        -->
        <receiver
            android:name=".data.notification.NotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
