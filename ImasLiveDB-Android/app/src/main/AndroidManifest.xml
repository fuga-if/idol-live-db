<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- P名刺: 相手の QR と紙の名刺を読むカメラ。カメラの無い端末でも入れられる (読むのは名刺ファイルでもできる)。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      P名刺: 近くの Android に担当の画像を直接送る (Nearby Connections。iOS の MultipeerConnectivity の対)。
      要る権限は Android の版で違う (Nearby Connections の案内のとおり)。
        全部の版: Wi-Fi の状態 (16 でも無いと MISSING_PERMISSION_ACCESS_WIFI_STATE で名乗れない)
        12 以上: BLUETOOTH_ADVERTISE / CONNECT / SCAN、13 以上はさらに NEARBY_WIFI_DEVICES
        12 未満: BLUETOOTH / BLUETOOTH_ADMIN
        位置: 10〜12L は FINE、9 以下は COARSE (13 以上は NEARBY_WIFI_DEVICES が代わる)
      実行時の要求は NearbyCardPermissions が版ごとに選ぶ。位置は近くの端末を探すためだけに要り、取らない。
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!-- 通知は Android 13+ でランタイム権限。設定画面の「通知を許可する」から要求する。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AlarmManager の予約は端末の再起動で全部消えるので、起動完了を受けて積み直す。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM は意図的に宣言しない。
      誕生日 9:00・日曜 20:00 といった通知は数分ずれても価値が落ちない一方、
      exact alarm はユーザーによる個別許可 (12+) を必要とし、USE_EXACT_ALARM は
      「アラーム/カレンダーが主目的のアプリ」限定という Play のポリシーがある。
      代わりに setAndAllowWhileIdle を使う (権限不要・Doze でも発火・数分の誤差)。
      詳細は NotificationScheduler の KDoc。
    -->

    <application
        android:name=".ImasLiveDBApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ImasLiveDB"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ImasLiveDB"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              P名刺の URL (https://idollivedb.fugaapp.site/p/#…)。中身は # の後ろなので path だけで受ける。
              App Links の確かめ (assetlinks.json) は Web 側 (web/public/.well-known) が置く。
              どの形を名刺と読むかはコア (classifyScannedCode) 一本 (ProducerCardIntents)。
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="idollivedb.fugaapp.site" />
                <!-- /polls なども /p で始まるので、前方一致ではなく完全一致で受ける (中身は # の後ろ)。 -->
                <data android:path="/p" />
                <data android:path="/p/" />
            </intent-filter>
            <!-- imaslivedb://p#… (アプリどうしで開く形)。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="imaslivedb" android:host="p" />
            </intent-filter>
            <!--
              名刺ファイル (.imascard)。MIME と拡張子はコアの cardFileTypeInfo と同じ値。
              Quick Share で受け取ったファイルはファイルアプリから開かれ、MIME が付かないことが多いので
              octet-stream も受ける (名刺ファイルかどうかは中身をコアが確かめる)。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.imaslivedb.card" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.imaslivedb.card" />
            </intent-filter>
        </activity>

        <!--
          Apple Music のサインイン (アプリ内ブラウザ) から戻る口。Worker の /music-auth の面が
          終わったら imaslivedb://music-auth へ飛ばす。トークンは URL に載らない
          (player/AppleMusicLyricsPlayback が Worker に一度だけ取りに行く)。
        -->
        <activity
            android:name=".player.MusicAuthReturnActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="imaslivedb" android:host="music-auth" />
            </intent-filter>
        </activity>

        <!--
          Spotify のログイン (アプリ内ブラウザ) から戻る口。利用者が自分の Spotify アプリに
          この Redirect URI を登録する (imas-core domain/spotify.rs の REDIRECT_URI)。
        -->
        <activity
            android:name=".data.spotify.SpotifyAuthReturnActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="imaslivedb" android:host="spotify-callback" />
            </intent-filter>
        </activity>

        <!--
          MusicKit for Android の認証画面は使わない (端末の Apple Music にサインイン済みだと
          結果が返らない不具合 FB24754184。サインインはアプリ内ブラウザで通す)。
          AAR が持ち込む画面と口を畳む。AAR が無いビルドでは何も起きない。
        -->
        <activity
            android:name="com.apple.android.sdk.authentication.SDKUriHandlerActivity"
            tools:node="remove" />
        <activity
            android:name="com.apple.android.sdk.authentication.StartAuthenticationActivity"
            tools:node="remove" />

        <!--
          シェアカード画像の受け渡し口。
          cacheDir に書いた PNG はアプリ専用領域なので他アプリからは読めず、file:// で渡すと
          Android 7 以降 FileUriExposedException で落ちる。FileProvider を挟んで content:// に
          化かし、ACTION_SEND の受け手へ一時的な読み取り権限だけを渡す。
          公開範囲は res/xml/provider_paths.xml の cache-path 1 つに限定 (exported は false)。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shareprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <!-- 予約時刻に叩かれて通知を 1 本出す。自アプリの AlarmManager からしか来ない。 -->
        <receiver
            android:name=".data.notification.NotificationAlarmReceiver"
            android:exported="false" />

        <!--
          予約が消える/ずれる出来事のあとに積み直す。
          exported="false" のままで届く: システム (uid=SYSTEM) が送るブロードキャストは
          非 exported なレシーバにも配送される (WorkManager の RescheduleReceiver と同じ形)。
        -->
        <receiver
            android:name=".data.notification.NotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          ===== ホーム画面ウィジェット (Glance) =====

          ウィジェットの provider は、システム/ランチャーがブロードキャストを送る相手なので
          exported="true" が必須 (非 exported だと一覧に出ない)。受け取るのは
          APPWIDGET_UPDATE だけで、中身は Glance が組み立てる。
          ラベル・説明・サイズは res/xml/*_widget_info.xml 側。
        -->

        <!-- 担当の画像。タップで次の画像へ送る。 -->
        <receiver
            android:name=".widget.OshiImageWidgetReceiver"
            android:exported="true"
            android:label="担当の画像（タップで切替）">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/oshi_image_widget_info" />
        </receiver>

        <!-- 担当の画像。タップでアプリを開く。絵は上と同じで、タップの意味だけが違う。 -->
        <receiver
            android:name=".widget.OshiLauncherWidgetReceiver"
            android:exported="true"
            android:label="担当の画像（タップでアプリ）">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/oshi_launcher_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.NextLiveWidgetReceiver"
            android:exported="true"
            android:label="次のライブ">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_live_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TodaySongWidgetReceiver"
            android:exported="true"
            android:label="今日の1曲">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_song_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TicketDeadlineWidgetReceiver"
            android:exported="true"
            android:label="チケット締切">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ticket_deadline_widget_info" />
        </receiver>

        <!--
          担当画像ウィジェットの設定画面。ランチャーが APPWIDGET_CONFIGURE で起動するので
          exported="true"。2 種類の担当画像ウィジェットで共用する (選ぶものが同じなので)。
        -->
        <activity
            android:name=".widget.OshiWidgetConfigureActivity"
            android:exported="true"
            android:label="担当を選ぶ"
            android:theme="@style/Theme.ImasLiveDB">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
          日付が変わったらウィジェットを描き直すための予約の受け口 (WidgetUpdateScheduler)。
          通知側と同じく、予約が消える/ずれる出来事のあとに積み直す。
          自アプリの AlarmManager とシステムからしか来ないので exported="false"。
        -->
        <receiver
            android:name=".widget.WidgetUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
