{
  "name": "imas-live-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "export": "cd ../imas-core && cargo run --release --locked --features web-export --bin web-export -- --sql ../db/master.sql --community ../db/community.sql --calls ../db/calls_dashboard.json --out ../web/data",
    "wasm": "cd wasm/imas-fold-wasm && wasm-pack build --release --target web --out-dir ../../src/lib/fold && cd ../imas-query-wasm && wasm-pack build --release --target web --out-dir ../../src/lib/query",
    "wasm:sync": "cd wasm/imas-sync-wasm && wasm-pack build --release --target web --out-dir pkg",
    "prebuild": "node scripts/require-data.mjs",
    "build": "astro build && node scripts/check-limits.mjs",
    "build:all": "npm run export && npm run wasm && npm run build",
    "dev": "astro dev",
    "dev:fixture": "IMAS_WEB_DATA=./data-fixture astro dev",
    "build:fixture": "IMAS_WEB_DATA=./data-fixture astro build",
    "preview": "wrangler dev",
    "preview:astro": "astro preview",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:fold": "vitest run tests/fold.parity.test.ts",
    "e2e": "npm run e2e:ledger && npm run build:fixture && playwright test",
    "e2e:changed": "node e2e/tools/changed.mjs",
    "e2e:ledger": "node e2e/tools/ledger.mjs",
    "e2e:inventory": "node e2e/tools/inventory.mjs --write",
    "e2e:install": "playwright install chromium",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@playwright/test": "1.63.0",
    "astro": "7.3.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0",
    "wrangler": "4.128.0"
  }
}
