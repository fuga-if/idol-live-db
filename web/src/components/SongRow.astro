---
import ListRow from "./ListRow.astro";
import Artwork from "./Artwork.astro";
import type { SongListItem } from "../lib/schema/SongListItem";

/**
 * 楽曲一覧の 1 行 (アプリの `ImasSongRow`、DESIGN_SYSTEM §5.1)。
 *
 *   [帯 = ブランドの色] [ジャケ 48] [曲名 / 歌唱者 / 日付・札] [N 回]
 *
 * 列に幅を配る表は曲名が「余り」になり潰れたので、行に積む。曲名が先に幅を取り、
 * 下段の札は折り返すだけで済む。ジャケが無い曲はブランド色の面 + 曲名 (`Artwork`)。
 * 札は種類ごとに別の要素 (文字列で繋がない)。語 (「ソロ曲」「作曲 …」「収録 …」) は Rust が付けたもの。
 * 末尾の披露回数は `.num`。全件ハブ (`light`) は行を ref だけに削ってあるので副題だけを置く。
 */
interface Props {
  item: SongListItem;
  light?: boolean;
}
const { item, light = false } = Astro.props;
const meta = light
  ? [item.subtitle]
  : [item.unitLabel, item.artistsLabel];
const badges = [item.songTypeLabel, item.collabLabel, item.kamisabiLabel].filter((m): m is string => !!m);
const credits = [item.composerCredit, item.cdCredit].filter((m): m is string => !!m);
const hasFoot = !!item.releaseDisplay || badges.length > 0 || credits.length > 0;
---

<ListRow variant="list-row--song" href={item.ref.path} themeKey={item.ref.themeKey} title={item.ref.name} meta={meta}>
  <Artwork slot="lead" title={item.ref.name} artworkUrl={item.ref.artworkUrl} size="sm" />
  {
    hasFoot && (
      <span slot="foot" class="list-row__foot">
        {item.releaseDisplay && (
          <time class="list-row__date" datetime={item.releaseDate ?? undefined}>
            {item.releaseDisplay}
          </time>
        )}
        {badges.map((b) => (
          <span class="badge">{b}</span>
        ))}
        {credits.map((c) => (
          <span class="list-row__credit">{c}</span>
        ))}
      </span>
    )
  }
  {
    item.performanceCount !== null && (
      <span slot="trailing" class="list-row__metric">
        <span class="num num--medium">{item.performanceCount}</span>
        <span class="num__unit">回</span>
      </span>
    )
  }
</ListRow>
