---
import DatedRow from "./DatedRow.astro";
import Artwork from "./Artwork.astro";
import Count from "./Count.astro";
import TagChip from "./TagChip.astro";
import type { SongListItem } from "../lib/schema/SongListItem";

/**
 * 楽曲一覧の 1 行 — [ジャケ] [曲名 + 札 / ユニット・歌唱アイドル / 作曲・収録] [初出 ・ 回数 ›]。
 *
 * 表 (曲 × 属性) は列に幅を配ると曲名が「余り」になり、幅によっては 1 文字ずつ縦に潰れた。
 * 行に積めば、どの幅でも曲名が先に幅を取り、属性は折り返すだけで済む。
 * 骨格はライブ・公演の行と同じ `DatedRow` で、先頭が日付ではなくジャケになるだけ。
 *
 * メタは**種類ごとに別の要素**で並べる (文字列で繋がない)。「作曲 …」「収録 …」の語は
 * Rust (`content::composer_credit` / `cd_credit`) が付けたもので、ここは置くだけ。
 * 作曲・収録は「読む」より「引く」ための情報なので、幅があるカードでだけ 3 行目に出す (CSS)。
 */
interface Props {
  item: SongListItem;
}
const { item } = Astro.props;
const meta = [item.unitLabel, item.artistsLabel].filter((m): m is string => !!m);
const credits = [item.composerCredit, item.cdCredit].filter((m): m is string => !!m);
---

<DatedRow variant="song-row" href={item.ref.path} themeKey={item.ref.themeKey}>
  <Artwork slot="lead" title={item.ref.name} artworkUrl={item.ref.artworkUrl} size="sm" />
  {/* 名前付きスロットに渡す中身は、要素の間の改行と字下げが落とされる。
      曲名と札の間の空白は見た目の間であり折り返しの位置なので、`{" "}` で書く。 */}
  <Fragment slot="title">
    {" "}{item.ref.name}{" "}
    {item.songTypeLabel && <TagChip text={item.songTypeLabel} kind="all" />}{" "}
    {/* 合同曲。ブランド別の一覧ではそのブランドの曲に混じって出るので、行で見分けられるように。 */}
    {item.collabLabel && <TagChip text={item.collabLabel} kind="cover" />}{" "}
    {/* KAMISABI (音楽カードゲーム) の収録札。 */}
    {item.kamisabiLabel && <TagChip text={item.kamisabiLabel} kind="guest" />}{" "}
  </Fragment>
  <Fragment slot="body">
    {" "}
    {
      meta.length > 0 && (
        <span class="row__meta">
          {meta.map((m) => (
            <span class="row__meta-item">{m}</span>
          ))}
        </span>
      )
    }{" "}
    {
      credits.length > 0 && (
        <span class="row__meta song-row__credits">
          {credits.map((m) => (
            <span class="row__meta-item">{m}</span>
          ))}
        </span>
      )
    }
  </Fragment>
  <Fragment slot="trailing">
    {item.releaseDate && <span class="song-row__date u-num">{item.releaseDate}</span>}{" "}
    <Count value={item.performanceCount} unit="回" strong />
  </Fragment>
</DatedRow>
