---
import ListLayout from "../layouts/ListLayout.astro";
import ListContainer from "./ListContainer.astro";
import ListRow from "./ListRow.astro";
import EmptyState from "./EmptyState.astro";
import type { VenueListPage } from "../lib/schema/VenueListPage";

interface Props {
  list: VenueListPage;
}
const { list } = Astro.props;
---

<ListLayout
  seo={list.seo}
  title={list.title}
  total={list.total}
  filters={list.filters}
  imprint="VENUES"
>
  {
    list.empty ? (
      <EmptyState {...list.empty} />
    ) : (
      <ListContainer as="ul">
        {list.items.map((item) => (
          <li>
            <ListRow
              title={item.ref.name}
              href={item.ref.path}
              themeKey={item.ref.themeKey}
              meta={[item.locationDisplay]}
            >
              <span slot="trailing" class="list-row__metrics">
                {item.capacity !== null && (
                  <span class="list-row__metric">
                    <span class="num num--medium">{item.capacity}</span>
                    <span class="num__unit">人</span>
                  </span>
                )}
                {item.showCount > 0 && (
                  <span class="list-row__metric">
                    <span class="num num--medium">{item.showCount}</span>
                    <span class="num__unit">公演</span>
                  </span>
                )}
              </span>
            </ListRow>
          </li>
        ))}
      </ListContainer>
    )
  }
</ListLayout>
