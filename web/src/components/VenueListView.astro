---
import ListLayout from "../layouts/ListLayout.astro";
import ListContainer from "./ListContainer.astro";
import LeadRow from "./LeadRow.astro";
import EmptyState from "./EmptyState.astro";
import { meta } from "../lib/data";
import type { VenueListPage } from "../lib/schema/VenueListPage";
import Count from "./Count.astro";

interface Props {
  list: VenueListPage;
}
const { list } = Astro.props;
---

<ListLayout
  seo={list.seo}
  meta={meta()}
  title={list.title}
  total={list.total}
  filterLinks={list.prefectureLinks}
  filterLabel="都道府県で絞る"
>
  {
    list.items.length === 0 ? (
      <EmptyState title="該当する会場がありません" />
    ) : (
      <ListContainer as="ul">
        {list.items.map((item) => (
          <li>
            <LeadRow
              title={item.ref.name}
              subtitle={item.locationDisplay}
              href={item.ref.path}
              themeKey={item.ref.themeKey}
            >
              <span slot="trailing" class="u-row">
                {item.capacity && <Count value={item.capacity} unit="人" />}
                {item.showCount > 0 && <Count value={item.showCount} unit="公演" />}
              </span>
            </LeadRow>
          </li>
        ))}
      </ListContainer>
    )
  }
</ListLayout>
