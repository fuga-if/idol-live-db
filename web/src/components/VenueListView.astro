---
import ListLayout from "../layouts/ListLayout.astro";
import ListContainer from "./ListContainer.astro";
import DatedRow from "./DatedRow.astro";
import EmptyState from "./EmptyState.astro";
import Count from "./Count.astro";
import type { VenueListPage } from "../lib/schema/VenueListPage";

interface Props {
  list: VenueListPage;
}
const { list } = Astro.props;
---

<ListLayout
  seo={list.seo}
  title={list.title}
  total={list.total}
  filterLinks={list.prefectureLinks}
  filterLabel="都道府県で絞る"
>
  {
    list.items.length === 0 ? (
      <EmptyState title="該当する会場がありません" />
    ) : (
      <ListContainer as="ul">
        {list.items.map((item) => (
          <li>
            <DatedRow
              title={item.ref.name}
              href={item.ref.path}
              themeKey={item.ref.themeKey}
              meta={[item.locationDisplay]}
            >
              <span slot="trailing" class="u-row">
                <Count strong value={item.capacity} unit="人" />
                {item.showCount > 0 && <Count strong value={item.showCount} unit="公演" />}
              </span>
            </DatedRow>
          </li>
        ))}
      </ListContainer>
    )
  }
</ListLayout>
