---
import type { TagChipDto } from "../lib/schema/TagChipDto";

/**
 * コミュニティが付けたタグ。
 *
 * **読むだけ。** 付ける/外すにはログインが要るので、この出面には操作を置かない
 * (押しても何も起きないものを置かない)。参加の導線は `OpenInApp` が担う。
 *
 * 中身は D1 の集計を焼き込んだもの (`db/community.sql` → `imas-core`)。
 * 閲覧のたびに D1 を読むと無料枠を超えるので、ビルド時に固める。
 *
 * 一覧のあるタグ (曲のタグ) は `path` を持ち、押すとそのタグの曲一覧へ行く。
 * 無いもの (アイドル・ユニットのタグ) は押せない札。どちらかは Rust が決めている。
 */
interface Props {
  tags: TagChipDto[];
}
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="u-row community-tags" aria-label="タグ">
      {tags.map((tag) => {
        const Tag = tag.path ? "a" : "span";
        return (
          <li>
            <Tag
              class:list={["tag", "tag--community", tag.isOfficial && "tag--official"]}
              style={tag.color ? `--tag-color: ${tag.color}` : undefined}
              href={tag.path ?? undefined}
            >
              {tag.name}
              <b class="community-tags__count">{tag.count}</b>
            </Tag>
          </li>
        );
      })}
    </ul>
  )
}
