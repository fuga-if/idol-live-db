---
import type { EventListItem } from "../lib/schema/EventListItem";
import type { Countdown } from "../lib/schema/Countdown";
/**
 * 紙のチケット (アプリの `ImasTicket`、DESIGN_SYSTEM §6.7)。トップの「次のライブ」。
 * 上に目印 (「次のライブ」)、題、日付と会場。右の半券にカウントダウン。英字の印字は置かない (2026-10-31)。
 * 紙はダークでも明るい。押すとそのライブへ。
 *
 * 材料は一覧と同じ `EventListItem`。どれが次のライブかは Rust が決めた順 (先頭)。
 * 日付は `DateBadge` の月日と曜日をそのまま置く。
 */
interface Props {
  item: EventListItem;
  label?: string;
  countdown?: Countdown | null;
}
const { item, label = "次のライブ", countdown } = Astro.props;
const badge = item.dateBadge ?? null;
const dateText = badge ? `${badge.monthDay}${badge.weekday ? ` (${badge.weekday})` : ""}` : null;
const metaParts = [item.endDisplay, item.venueDisplay].filter((s): s is string => !!s);
const countdownIsText = countdown ? !/^\d+$/.test(countdown.value) : false;
---

<div class="ticket-wrap">
  <a class:list={["ticket", !countdown && "ticket--plain"]} data-theme={item.ref.themeKey} href={item.ref.path}>
    <span class="ticket__main">
      <span class="ticket__label">
        <span class="penlight" aria-hidden="true"></span>
        <span>{label}</span>
      </span>
      <span class="ticket__title">{item.ref.name}</span>
      {
        (dateText || metaParts.length > 0) && (
          <span class="ticket__meta">
            {dateText && (
              <>
                <span class="u-visually-hidden">{badge!.spoken}</span>
                <span class="num" aria-hidden="true">
                  {dateText}
                </span>
              </>
            )}
            {dateText && metaParts.length > 0 && <span aria-hidden="true"> · </span>}
            {metaParts.map((m, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <span>{m}</span>
              </>
            ))}
          </span>
        )
      }
    </span>
    {
      countdown && (
        <span class="ticket__stub">
          <span class="u-visually-hidden">{countdown.spoken}</span>
          {countdown.lead && (
            <span class="ticket__unit" aria-hidden="true">
              {countdown.lead}
            </span>
          )}
          <b class="num num--countdown" data-text={countdownIsText ? "" : undefined} aria-hidden="true">
            {countdown.value}
          </b>
          {countdown.unit && (
            <span class="ticket__unit" aria-hidden="true">
              {countdown.unit}
            </span>
          )}
        </span>
      )
    }
  </a>
</div>
