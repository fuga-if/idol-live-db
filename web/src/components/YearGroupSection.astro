---
import EventRow from "./EventRow.astro";
import type { YearGroup } from "../lib/schema/YearGroup";
/**
 * 年 (または入口の「開催済み (2026年)」) の束 1 つ。見出しの文字は Rust が決める。
 * 見出しは `ImasDateHeader` と同じ 1 段 (年の数字だけ。月は半券の上段に出る)。
 * 行は半券の行を `.stub-list` に並べる。開催済みの束は見出しを ink3 にする。
 */
interface Props {
  title: string;
  group: YearGroup;
  past?: boolean;
}
const { title, group, past = false } = Astro.props;
---

<section class="year-group" aria-label={title} data-past={past ? "" : undefined}>
  <h2 class="year-group__title num">{title}</h2>
  <ul class="stub-list">
    {group.events.map((e) => <EventRow item={e} />)}
  </ul>
</section>
