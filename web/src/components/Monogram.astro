---
/**
 * 絵の代わりの「顔」(アプリの ImasAvatar の画像なし時と同じ)。
 * 版権物ゼロなので顔写真は持てない。淡い色面 + 細い輪 + 短い名 (Rust の `Ref.monogram` /
 * `IdolPage.monogram`) を丸に置く。色は囲む要素の `data-theme` から。
 * 文字数は `data-chars` に出し、3〜4 文字は CSS が縮める (Rust が 4 文字までに切っている)。
 * インライン style は CSP (`style-src 'self'`) で効かないので属性で渡す。
 */
interface Props {
  /** Rust が決めた短い名。無ければ空の丸 (規則の欠けを隠さない)。 */
  label: string | null;
  /** `avatar` = タイルの顔、`hero` = 詳細ページの顔。 */
  size?: "avatar" | "hero";
}
const { label, size = "avatar" } = Astro.props;
const chars = label ? Array.from(label).length : 0;
---

<span
  class:list={["monogram", size === "hero" && "monogram--hero"]}
  data-chars={chars}
  aria-hidden="true"
>
  {label}
</span>
