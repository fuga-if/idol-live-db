---
import Board from "./Board.astro";
import type { StatTile } from "../lib/schema/StatTile";
/**
 * 統計の並び。**どの数を何の順で出すかは Rust の `stat_tiles` が決める**
 * (トップ / About / ブランドで同じ形を使う)。見た目は電光掲示板 (`Board`)。
 */
interface Props {
  tiles: readonly StatTile[];
}
const { tiles } = Astro.props;
---

<Board title="STATS" cells={tiles} />
