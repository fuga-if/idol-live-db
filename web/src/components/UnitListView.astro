---
import ListLayout from "../layouts/ListLayout.astro";
import ListContainer from "./ListContainer.astro";
import DatedRow from "./DatedRow.astro";
import EmptyState from "./EmptyState.astro";
import TagChip from "./TagChip.astro";
import Count from "./Count.astro";
import KanaIndex from "./KanaIndex.astro";
import { kanaAnchorId } from "../lib/anchors";
import type { UnitListPage } from "../lib/schema/UnitListPage";

interface Props {
  list: UnitListPage;
}
const { list } = Astro.props;
const sectionStarts = new Set(list.kanaSections.map((s) => s.startIndex));
---

<ListLayout
  seo={list.seo}
  title={list.title}
  total={list.total}
  themeKey={list.brand?.themeKey}
  filters={list.filters}
>
  <KanaIndex sections={list.kanaSections} />
  {
    list.items.length === 0 ? (
      <EmptyState title="該当するユニットがありません" />
    ) : (
      <ListContainer as="ul">
        {list.items.map((item, i) => {
          return (
            <li id={sectionStarts.has(i) ? kanaAnchorId(i) : undefined}>
              <DatedRow
                title={item.ref.name}
                href={item.ref.path}
                themeKey={item.ref.themeKey}
                meta={[item.brand?.name ?? item.ref.sub]}
              >
                <span slot="trailing" class="u-row">
                  {item.note && <TagChip text={item.note} kind="all" />}
                  <Count strong value={item.memberCount} unit="人" />
                  {item.songCount > 0 && <Count strong value={item.songCount} unit="曲" />}
                </span>
              </DatedRow>
            </li>
          );
        })}
      </ListContainer>
    )
  }
</ListLayout>
