---
import ListLayout from "../layouts/ListLayout.astro";
import ListContainer from "./ListContainer.astro";
import ListRow from "./ListRow.astro";
import EmptyState from "./EmptyState.astro";
import KanaIndex from "./KanaIndex.astro";
import { kanaAnchorId } from "../lib/anchors";
import type { UnitListPage } from "../lib/schema/UnitListPage";

interface Props {
  list: UnitListPage;
}
const { list } = Astro.props;
const sectionStarts = new Set(list.kanaSections.map((s) => s.startIndex));
---

<ListLayout
  seo={list.seo}
  title={list.title}
  total={list.total}
  themeKey={list.brand?.themeKey}
  filters={list.filters}
>
  <KanaIndex sections={list.kanaSections} />
  {
    list.empty ? (
      <EmptyState {...list.empty} />
    ) : (
      <ListContainer as="ul" rows>
        {list.items.map((item, i) => (
          <li id={sectionStarts.has(i) ? kanaAnchorId(i) : undefined}>
            <ListRow
              title={item.ref.name}
              href={item.ref.path}
              themeKey={item.ref.themeKey}
              meta={[item.brand?.name ?? item.ref.sub]}
            >
              <span slot="trailing" class="list-row__metrics">
                {item.note && <span class="badge">{item.note}</span>}
                <span class="list-row__metric">
                  <span class="num num--medium">{item.memberCount.toLocaleString("ja-JP")}</span>
                  <span class="num__unit">人</span>
                </span>
                {item.songCount > 0 && (
                  <span class="list-row__metric">
                    <span class="num num--medium">{item.songCount.toLocaleString("ja-JP")}</span>
                    <span class="num__unit">曲</span>
                  </span>
                )}
              </span>
            </ListRow>
          </li>
        ))}
      </ListContainer>
    )
  }
</ListLayout>
