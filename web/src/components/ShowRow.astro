---
import LeadRow from "./LeadRow.astro";
import type { ShowSummary } from "../lib/schema/ShowSummary";
import Count from "./Count.astro";
/**
 * 公演 1 件の行。
 * 副題は Rust が文脈ごとに組んだ `subtitle` をそのまま置く
 * (ライブ詳細では親ライブ名を出さない、といった出し分けも emit 側で決まっている)。
 */
interface Props {
  show: ShowSummary;
}
const { show } = Astro.props;
---

<li>
  <LeadRow
    title={show.ref.name}
    subtitle={show.subtitle}
    href={show.ref.path}
    themeKey={show.ref.themeKey}
  >
    <span slot="trailing" class="u-row">
      <time class="u-num" datetime={show.date}>{show.date}</time>
      {show.setlistCount > 0 && <Count value={show.setlistCount} unit="曲" />}
    </span>
  </LeadRow>
</li>
