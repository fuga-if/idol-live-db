---
import StubRow from "./StubRow.astro";
import type { ShowSummary } from "../lib/schema/ShowSummary";
/**
 * 公演 1 件の行 = 半券の行 (`ImasShowRow`)。
 *
 * 見出し (`title`: ライブの中では公演名、外ではライブ名) と副題の公演名 (`showLabel`)、
 * 会場名を出すか (会場詳細では出さない) は **JSON を作る側が文脈ごとに決めてある**
 * (`emit::events::ShowContext`)。ここは来た項目を置く場所を決めるだけ。
 * 末尾はセトリの曲数 (数字は細長い太字、単位は小さく灰)。
 */
interface Props {
  show: ShowSummary;
}
const { show } = Astro.props;
---

<li>
  <StubRow
    badge={show.dateBadge}
    title={show.title}
    href={show.ref.path}
    themeKey={show.ref.themeKey}
    meta={[show.showLabel, show.venueLabel, show.hall, show.startTimeDisplay]}
  >
    {
      show.setlistCount > 0 && (
        <span slot="trailing" class="num num--medium">
          {show.setlistCount}
          <span class="num__unit">曲</span>
        </span>
      )
    }
  </StubRow>
</li>
