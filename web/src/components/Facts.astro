---
import LabeledRow from "./LabeledRow.astro";
import type { ProfileRow } from "../lib/schema/ProfileRow";
/**
 * 事実の並び (日程・開演・会場 …)。
 *
 * 行は Rust の `ProfileRow` (曲の `factRows` / 会場の `factRows` / 公演の `factRows`)
 * そのもの。どの行を出すか・順・見出し・リンク・数字の見せ方 (`style`) は向こうで
 * 決まっていて、ここは来た行を置くだけ。
 *
 * - `inline`: 頭の副題に流す 1 行 (`開演 17:30  会場 …`)。項目名は灰、値は墨。
 * - `stack`: 項目と値の行 (`ImasValueRow`) を紙のカードに積む。
 */
interface Props {
  rows: readonly ProfileRow[];
  variant?: "stack" | "inline";
}
const { rows, variant = "stack" } = Astro.props;
---

{
  rows.length > 0 &&
    (variant === "inline" ? (
      <dl class="facts">
        {rows.map((r) => (
          <div class="facts__item">
            <dt class="facts__label">{r.label}</dt>
            <dd class:list={["facts__value", r.style === "monospaced" && "num"]}>
              {r.link ? <a class="u-underline-hover" href={r.link}>{r.value}</a> : r.value}
            </dd>
          </div>
        ))}
      </dl>
    ) : (
      <div class="card">
        {rows.map((r) => (
          <LabeledRow label={r.label} value={r.value} href={r.link} mono={r.style === "monospaced"} />
        ))}
      </div>
    ))
}
