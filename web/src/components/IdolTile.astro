---
import ColorDot from "./ColorDot.astro";
import type { Ref } from "../lib/schema/Ref";
/**
 * アイドル / ユニットのグリッド 1 枚。色の円と名前と副題だけ (版権物ゼロなので絵は無い)。
 *
 * 副題は省略時 `Ref.sub` (アイドルならブランド名)。ブランド詳細やユニット詳細のように
 * 並ぶ全員が同じブランドの場所では、Rust が `sub` を落とした `Ref` を配ってくる。
 * `data-entity-id` は絞り込みの島が行を引くための鍵。wasm は id を返すので、
 * 添字で結び付けない (配った生テーブルとページの生成が同じ版である前提を作らない)。
 */
interface Props {
  entity: Ref;
  sub?: string | null;
}
const { entity, sub } = Astro.props;
const subtitle = sub ?? entity.sub;
---

<li data-entity-id={entity.id}>
  <a class="tile" data-theme={entity.themeKey} href={entity.path}>
    <ColorDot size="avatar" />
    <span class="tile__name u-underline-hover">{entity.name}</span>
    {subtitle && <span class="tile__sub u-clamp1">{subtitle}</span>}
  </a>
</li>
