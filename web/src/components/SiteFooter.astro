---
import type { AppLinks } from "../lib/schema/AppLinks";
/**
 * サイト共通フッタ。
 * プライバシー / サポート / 利用規約は既存の GitHub Pages にリンクする (複製しない)。
 * 更新日はここに出さない (DECISIONS A17: 日次再ビルドで全 HTML が変わるのを避ける)。
 */
interface Props {
  app: AppLinks;
}
const { app } = Astro.props;
---

<footer class="site-footer">
  <div class="page">
    <div class="site-footer__cols">
      <nav aria-label="データ">
        <h2>データ</h2>
        <ul>
          <li><a href="/events/">ライブ</a></li>
          <li><a href="/songs/">楽曲</a></li>
          <li><a href="/idols/">アイドル</a></li>
          <li><a href="/units/">ユニット</a></li>
          <li><a href="/venues/">会場</a></li>
          <li><a href="/brands/">ブランド</a></li>
        </ul>
      </nav>
      <nav aria-label="このサイトについて">
        <h2>About</h2>
        <ul>
          <li><a href="/about/">このサイトについて</a></li>
          <li><a href="/search/">検索</a></li>
          <li>
            <a href={app.repositoryUrl} rel="noopener">GitHub (データに協力)</a>
          </li>
        </ul>
      </nav>
      <nav aria-label="アプリ">
        <h2>App</h2>
        <ul>
          <li><a href={app.appStoreUrl} rel="noopener">App Store</a></li>
          <li><a href={app.privacyUrl} rel="noopener">プライバシーポリシー</a></li>
          <li><a href={app.supportUrl} rel="noopener">サポート</a></li>
          <li><a href={app.termsUrl} rel="noopener">利用規約</a></li>
        </ul>
      </nav>
    </div>
    <div class="site-footer__note">
      <p>
        本サイトは非公式のファンメイドです。「アイドルマスター」およびブランド名・
        作品名は株式会社バンダイナムコエンターテインメントおよび各権利者に帰属します。
      </p>
      <p>
        キャラクター画像・公式ロゴ・歌詞は掲載していません。ジャケット画像は
        Apple Music の提供によるものです。
      </p>
    </div>
  </div>
</footer>
