---
import ListLayout from "../layouts/ListLayout.astro";
import ListContainer from "./ListContainer.astro";
import Artwork from "./Artwork.astro";
import MetricBadge from "./MetricBadge.astro";
import EmptyState from "./EmptyState.astro";
import { meta } from "../lib/data";
import type { SongListPage } from "../lib/schema/SongListPage";

/** 楽曲一覧 (総合 / ブランド別 / all)。何を載せるかは Rust の SongListFilter が決めている。 */
interface Props {
  list: SongListPage;
}
const { list } = Astro.props;
---

<ListLayout
  seo={list.seo}
  meta={meta()}
  title={list.title}
  total={list.total}
  themeKey={list.brand?.themeKey}
  filterLinks={list.brandLinks}
  filterLabel="ブランドで絞る"
  wide
>
  {
    list.kanaSections.length > 0 && (
      <nav class="link-chips" aria-label="よみで飛ぶ">
        {list.kanaSections.map((s) => (
          <a href={`#kana-${s.startIndex}`}>
            {s.label}
            <span class="u-dim u-num">&nbsp;{s.count}</span>
          </a>
        ))}
      </nav>
    )
  }

  {
    list.items.length === 0 ? (
      <EmptyState title="該当する楽曲がありません" body="別のブランドに切り替えるか、検索からお探しください。" />
    ) : (
      <ListContainer as="ul">
        {list.items.map((item, i) => {
          const section = list.kanaSections.find((s) => s.startIndex === i);
          return (
            <li id={section ? `kana-${i}` : undefined}>
              <a class="ranking-row" data-theme={item.ref.themeKey} href={item.ref.path}>
                <Artwork title={item.ref.name} artworkUrl={item.ref.artworkUrl} size="sm" />
                <span class="ranking-row__body">
                  <span class="ranking-row__title u-clamp1 u-underline-hover">{item.ref.name}</span>
                  {item.subtitle && <span class="ranking-row__sub u-clamp1">{item.subtitle}</span>}
                </span>
                {/* `/songs/all/` の軽い行では null。0 回披露と取り違えないよう
                    「載せていない」を素通りさせる。 */}
                {item.performanceCount != null && item.performanceCount > 0 && (
                  <MetricBadge value={item.performanceCount} unit="回" muted />
                )}
              </a>
            </li>
          );
        })}
      </ListContainer>
    )
  }

  {
    /* 一覧規則 (SongListFilter の既定) から外れる曲へのハブ。
       ここに置かないと、派生曲・ライブ限定曲・other ブランドの曲の詳細ページが
       トップからどこからも辿れなくなる (到達性の要)。 */
    list.allSongsLink && (
      <p class="u-muted">
        一覧に出していない曲 (派生曲・ライブ限定・その他ブランド) もあります。
        <a class="u-underline-hover" href={list.allSongsLink.path}>
          {list.allSongsLink.label}
        </a>
        <span class="u-dim u-num">&nbsp;{list.allSongsLink.count}</span>
      </p>
    )
  }
</ListLayout>
