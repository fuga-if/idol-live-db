---
import ListLayout from "../layouts/ListLayout.astro";
import SongTable from "./SongTable.astro";
import ListFilterBar from "./ListFilterBar.astro";
import KanaIndex from "./KanaIndex.astro";
import { kanaAnchorId } from "../lib/anchors";
import ListContainer from "./ListContainer.astro";
import RankingRow from "./RankingRow.astro";
import EmptyState from "./EmptyState.astro";
import type { SongListPage } from "../lib/schema/SongListPage";
import Count from "./Count.astro";

/** 楽曲一覧 (総合 / ブランド別 / all)。何を載せるかは Rust の SongListFilter が決めている。 */
interface Props {
  list: SongListPage;
}
const { list } = Astro.props;
const sectionStarts = new Set(list.kanaSections.map((s) => s.startIndex));
---

<ListLayout
  seo={list.seo}
  title={list.title}
  total={list.total}
  themeKey={list.brand?.themeKey}
  filterLinks={list.brandLinks}
  filterLabel="ブランドで絞る"
  wide
>
  <KanaIndex sections={list.kanaSections} />

  {list.queryBase && <ListFilterBar kind="songs" queryBase={list.queryBase} total={list.total} />}

  {
    list.items.length === 0 ? (
      <EmptyState title="該当する楽曲がありません" body="別のブランドに切り替えるか、検索からお探しください。" />
    ) : list.rowsAreLight ? (
      /* `/songs/all/` は行を ref だけに削った到達性のためのハブ。列が無いので表にせず、
         `.card > li` の content-visibility が効くリストのまま出す (3,153 行)。 */
      <ListContainer as="ul">
        {list.items.map((item, i) => {
          return (
            <li id={sectionStarts.has(i) ? kanaAnchorId(i) : undefined}>
              <RankingRow
                artwork
                title={item.ref.name}
                sub={item.subtitle}
                artworkUrl={item.ref.artworkUrl}
                href={item.ref.path}
                themeKey={item.ref.themeKey}
              />
            </li>
          );
        })}
      </ListContainer>
    ) : (
      <SongTable items={list.items} kanaSections={list.kanaSections} />
    )
  }

  {
    /* 一覧規則 (SongListFilter の既定) から外れる曲へのハブ。
       ここに置かないと、派生曲・ライブ限定曲・other ブランドの曲の詳細ページが
       トップからどこからも辿れなくなる (到達性の要)。 */
    list.allSongsLink && (
      <p class="u-muted">
        一覧に出していない曲 (派生曲・ライブ限定・その他ブランド) もあります。
        <a class="u-underline-hover" href={list.allSongsLink.path}>
          {list.allSongsLink.label}
        </a>
        <Count value={list.allSongsLink.count} dim />
      </p>
    )
  }
</ListLayout>
