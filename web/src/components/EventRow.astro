---
import DatedRow from "./DatedRow.astro";
import BrandMark from "./BrandMark.astro";
import TagChip from "./TagChip.astro";
import type { EventListItem } from "../lib/schema/EventListItem";
/**
 * 一覧の 1 ライブ。
 * 日付は左の日付ブロック、期間の終端・公演数・会場は文字、ブランドは色付きの札、
 * 種別は右端の札。**何を出すかは全部 Rust が決めた項目**で、ここは置く場所を決めるだけ
 * (`brandMark` / `kindLabel` / `showCountDisplay` / `endDisplay` は要らない文脈では null で来る)。
 */
interface Props {
  item: EventListItem;
  /** 年の見出しの下に並ぶ行では、日付ブロックの年を落とす。 */
  showYear?: boolean;
}
const { item, showYear = true } = Astro.props;
---

<li>
  <DatedRow
    badge={item.dateBadge}
    showYear={showYear}
    title={item.ref.name}
    href={item.ref.path}
    themeKey={item.ref.themeKey}
    meta={[item.endDisplay, item.showCountDisplay, item.venueDisplay]}
  >
    {
      item.brandMark && (
        <span slot="meta" class="row__meta-item">
          <BrandMark brand={item.brandMark} short />
        </span>
      )
    }
    {
      item.kindLabel && (
        <span slot="trailing">
          <TagChip text={item.kindLabel} kind="all" />
        </span>
      )
    }
  </DatedRow>
</li>
