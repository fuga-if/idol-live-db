---
import LeadRow from "./LeadRow.astro";
import type { EventListItem } from "../lib/schema/EventListItem";
import TagChip from "./TagChip.astro";
/**
 * 一覧の 1 ライブ。
 * 副題は Rust が文脈ごとに組んだ `subtitle` をそのまま置く
 * (ブランド別ページでブランド名を落とすかどうかも emit 側で決まっている)。
 */
interface Props {
  item: EventListItem;
}
const { item } = Astro.props;
---

<li>
  <LeadRow
    title={item.ref.name}
    subtitle={item.subtitle}
    href={item.ref.path}
    themeKey={item.ref.themeKey}
  >
    <span slot="trailing" class="u-row">
      <TagChip text={item.kindLabel} kind="all" />
    </span>
  </LeadRow>
</li>
