---
import StubRow from "./StubRow.astro";
import TagChip from "./TagChip.astro";
import type { EventListItem } from "../lib/schema/EventListItem";
/**
 * 一覧の 1 ライブ = 半券の行 (`ImasEventRow`)。
 * 左の半券に初日、行頭の帯にブランドの色、副題にブランド・期間の終端・公演数・会場、
 * 札に種別。**何を出すかは全部 Rust が決めた項目**で、ここは置く場所を決めるだけ
 * (`brandMark` / `kindLabel` / `showCountDisplay` / `endDisplay` は要らない文脈では null で来る)。
 * 名前の前に色の点は置かない (色は行頭の帯、名前は文字が言う)。
 */
interface Props {
  item: EventListItem;
}
const { item } = Astro.props;
---

<li>
  <StubRow
    badge={item.dateBadge}
    title={item.ref.name}
    href={item.ref.path}
    themeKey={item.ref.themeKey}
    meta={[item.brandMark ? (item.brandMark.sub ?? item.brandMark.name) : null, item.endDisplay, item.showCountDisplay, item.venueDisplay]}
  >
    {
      item.kindLabel && (
        <Fragment slot="badges">
          <TagChip text={item.kindLabel} kind="all" />
        </Fragment>
      )
    }
  </StubRow>
</li>
