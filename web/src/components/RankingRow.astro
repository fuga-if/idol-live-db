---
import Artwork from "./Artwork.astro";
import MetricBadge from "./MetricBadge.astro";
/**
 * ImasRankingRow の Web 版 — 順位 + (曲ならジャケ写) + 名前 + 数値。
 * `rank` と `metric` は省略可 (順位を振らない一覧・回数を持たない行でも同じ形を使う)。
 *
 * アイドル/ユニットの行に絵は付かない。版権物を持てないので出せるのは頭文字だけで、
 * それは名前の隣に置いても何も足さない。
 */
interface Props {
  rank?: number;
  /** 先頭にジャケ写を出すか。曲の行だけ true。 */
  artwork?: boolean;
  title: string;
  sub?: string | null;
  artworkUrl?: string | null;
  metric?: number | string | null;
  unit?: string;
  href: string;
  themeKey?: string;
}
const {
  rank,
  artwork = false,
  title,
  sub,
  artworkUrl,
  metric,
  unit = "回",
  href,
  themeKey,
} = Astro.props;
---

<a
  class:list={["ranking-row", rank !== undefined && rank <= 3 && "ranking-row--top"]}
  data-theme={themeKey}
  href={href}
>
  {rank !== undefined && <span class="ranking-row__rank">{rank}</span>}
  {
    artwork ? (
      <Artwork title={title} artworkUrl={artworkUrl} size="sm" />
    ) : (
      <span class="color-dot" aria-hidden="true" />
    )
  }
  <span class="ranking-row__body">
    <span class="ranking-row__title u-clamp1 u-underline-hover">{title}</span>
    {sub && <span class="ranking-row__sub u-clamp1">{sub}</span>}
  </span>
  {
    /* 順位を振らない一覧では数値を強調しない (2,000 行が全部アクセント色になると
       「上位」の意味が消える)。順位付きの行だけ accent にする。 */
    metric !== undefined && metric !== null && (
      <MetricBadge value={metric} unit={unit} muted={rank === undefined} />
    )
  }
</a>
