---
/** ImasSectionHeader の Web 版。見出しはアンカーになる (`aria-labelledby` の相手)。 */
interface Props {
  title: string;
  count?: number | string | null;
  moreHref?: string;
  moreLabel?: string;
  id?: string;
}
const { title, count, moreHref, moreLabel = "すべて見る", id } = Astro.props;
---

<div class="section__head">
  <h2 class="section__title" id={id}>{title}</h2>
  {count !== undefined && count !== null && <span class="section__count">{count}</span>}
  {moreHref && <a class="section__more" href={moreHref}>{moreLabel} ›</a>}
</div>
