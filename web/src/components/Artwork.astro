---
/**
 * ImasArtwork の Web 版。
 * 画像は `songs.artwork_url` (Apple Music CDN) のみ。無ければアクセント面 + 曲名。
 * フォールバック面は常に敷いておくので、画像が出なくてもレイアウトが崩れない。
 */
interface Props {
  title: string;
  artworkUrl?: string | null;
  themeKey?: string;
  size?: "sm" | "md" | "lg" | "hero";
  class?: string;
}
const { title, artworkUrl, themeKey, size = "md", class: cls = "" } = Astro.props;
const px = { sm: 44, md: 56, lg: 120, hero: 160 }[size];
const sizeClass = size === "md" ? "" : `artwork--${size}`;
---

<span class:list={["artwork", sizeClass, cls]} data-theme={themeKey}>
  <span class="artwork__fallback">{title}</span>
  {
    artworkUrl && (
      <img
        src={artworkUrl}
        alt=""
        width={px}
        height={px}
        loading="lazy"
        decoding="async"
      />
    )
  }
</span>
