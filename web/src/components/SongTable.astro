---
import Artwork from "./Artwork.astro";
import Count from "./Count.astro";
import type { SongListItem } from "../lib/schema/SongListItem";
import type { KanaSection } from "../lib/schema/KanaSection";

/**
 * 楽曲一覧の表。
 *
 * 一覧が二次元 (曲 × 属性) になるものは、行を積むより**表のほうが密度が出る**。
 * ただし列を出すには幅が要るので、**使える幅に応じて列を減らし**、最後は Rust が
 * 組んだ `subtitle` 1 本に畳む。マークアップは 1 つで、切替は CSS だけ。
 *
 * 幅の判定は**ビューポートではなくコンテナ**で行う (`@container`)。サイドバーが
 * 出ると本文の幅はその分だけ狭くなるので、ビューポート幅で決めると、同じ
 * 見た目の幅なのにサイドバーの有無で表の形が変わってしまう。
 *
 * **区切り文字を CSS で作らない。** 「ユニット ・ 原唱者 ・ 初出」の畳み方を決めるのは
 * `imas-core` の `display_join` 1 箇所で、ここは組み上がった `subtitle` を置くだけ。
 *
 * 行を `ref` だけに削った一覧 (`/songs/all/`) はそもそもここへ来ない
 * (列が 1 つも無い表になるうえ、表の行には `content-visibility` が効かない)。
 * 振り分けは `SongListView` が `rowsAreLight` で行う。
 *
 * 幅は `colgroup` ではなく `thead th` に持たせる。`table-layout: fixed` では
 * `col` を消しても列と中身の対応がずれるだけなので、列の出し入れは th/td の対で行う。
 */
interface Props {
  items: readonly SongListItem[];
  kanaSections: readonly KanaSection[];
}
const { items, kanaSections } = Astro.props;
const sectionStarts = new Set(kanaSections.map((s) => s.startIndex));
---

<div class="card song-table__scroll" data-song-table>
  <table class="song-table">
    <thead>
      <tr>
        <th scope="col" class="song-table__c-title">曲名</th>
        <th scope="col" class="song-table__c-unit">ユニット</th>
        <th scope="col" class="song-table__c-artists">原唱者</th>
        <th scope="col" class="song-table__c-date song-table__num">初出</th>
        <th scope="col" class="song-table__c-count song-table__num">ライブ</th>
      </tr>
    </thead>
    <tbody>
      {
        items.map((item, i) => (
          <tr id={sectionStarts.has(i) ? `kana-${i}` : undefined} data-row={i} data-theme={item.ref.themeKey}>
            <th scope="row" class="song-table__c-title song-table__title">
              {/* themeKey は tr から継承する。行ごとに 2 回置くと、
                  2,000 行規模で custom property の再計算が倍になる。 */}
              <a href={item.ref.path}>
                <Artwork title={item.ref.name} artworkUrl={item.ref.artworkUrl} size="sm" />
                <span>{item.ref.name}</span>
              </a>
            </th>
            <td class="song-table__c-unit song-table__dim">{item.unitLabel}</td>
            <td class="song-table__c-artists song-table__dim">{item.artistsLabel}</td>
            <td class="song-table__c-date song-table__num song-table__dim u-num">
              {item.releaseDate}
            </td>
            <td class="song-table__c-count song-table__num">
              {item.performanceCount !== null && <Count value={item.performanceCount} />}
            </td>
            {/* 列を落としたぶんの受け皿。列と排他で、同時に見えることはない。 */}
            <td class="song-table__subtitle">{item.subtitle}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
