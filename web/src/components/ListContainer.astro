---
/** ImasListContainer 相当。
    `rows` は一覧の行 (`ListRow` / `SongRow`) の入れ物: 角丸にせず、surface の帯が本文幅いっぱいに続き、
    行間は hairline (線は行の本文の頭から。`lists.css` の `.rows`)。
    既定は詳細ページの項目表などに使う角丸のカード (行の間に自動で罫が入る)。
    余った属性 (data-*) は器にそのまま渡す (絞り込みの島が器を探す目印に使う)。 */
interface Props {
  as?: "div" | "ul" | "ol";
  rows?: boolean;
  [key: `data-${string}`]: string | undefined;
}
const { as: Tag = "div", rows = false, ...rest }: Props = Astro.props;
---

<Tag class={rows ? "rows" : "card"} {...rest}><slot /></Tag>
