---
import {
  PERFORMER_NAME_MODES,
  PERFORMER_NAME_LABELS,
  DEFAULT_MODE,
} from "../lib/prefs/performerName";

/**
 * セトリの歌唱者をどの名前で出すかの切り替え。
 *
 * **表示の好みだけを持つ。** サーバには送らず、ログインも要らない
 * (この出面は書き込まない・状態をサーバに持たない、という原則は崩さない)。
 * 選択は localStorage に残り、次の訪問でも効く。
 *
 * JS が動かない環境では出さない (押しても何も起きないものを置かない)。
 * 器は `hidden` で描いておき、島が起動したときに外す。
 */
---

<div class="perf-pref" data-performer-pref hidden>
  <label class="perf-pref__label" for="performer-name">歌唱者の表示</label>
  <select class="song-filter__select" id="performer-name" data-performer-select>
    {
      PERFORMER_NAME_MODES.map((m) => (
        <option value={m} selected={m === DEFAULT_MODE}>
          {PERFORMER_NAME_LABELS[m]}
        </option>
      ))
    }
  </select>
</div>

<script>
  import { readMode, writeMode, type PerformerNameMode } from "../lib/prefs/performerName";

  const root = document.querySelector<HTMLElement>("[data-performer-pref]");
  const select = root?.querySelector<HTMLSelectElement>("[data-performer-select]");
  if (root && select) {
    // モードは body に置く。切り替えの実体は CSS 側 (components.css) で、
    // どちらの名前を見せるかだけが変わる。
    const apply = (mode: PerformerNameMode) => {
      document.body.dataset.performerName = mode;
      select.value = mode;
    };
    apply(readMode());
    select.addEventListener("change", () => {
      const mode = select.value as PerformerNameMode;
      writeMode(mode);
      apply(mode);
    });
    root.hidden = false;
  }
</script>
