---
import Count from "./Count.astro";
import { kanaAnchorId } from "../lib/anchors";
import type { KanaSection } from "../lib/schema/KanaSection";
/** よみの目次 (曲・ユニット共通)。区画の切り方は Rust の `KanaSection`。 */
interface Props {
  sections: readonly KanaSection[];
}
const { sections } = Astro.props;
---

{
  sections.length > 0 && (
    <nav class="link-chips" aria-label="よみで飛ぶ" data-kana-index>
      {sections.map((s) => (
        <a href={`#${kanaAnchorId(s.startIndex)}`}>
          {s.label}
          <Count value={s.count} dim />
        </a>
      ))}
    </nav>
  )
}
