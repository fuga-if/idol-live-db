---
/**
 * ImasAvatar の Web 版 — 淡ティント面 + 細リング + アクセント頭文字。
 * 版権物ゼロの制約により **画像は持たない** (常にモノグラム)。
 * モノグラムの文字は Rust が `Ref.monogram` として出す (アプリの ImasAvatar と同じ規則)。
 */
interface Props {
  /**
   * アプリの ImasAvatar と同じ頭文字。`Ref.monogram` が必ず持っている。
   * この span は aria-hidden なので、読み上げ名は囲っているリンクの文言が担う。
   */
  monogram: string;
  themeKey?: string;
  size?: "sm" | "md" | "lg" | "xl";
  class?: string;
}
const { monogram, themeKey, size = "md", class: cls = "" } = Astro.props;
const sizeClass = size === "md" ? "" : `avatar--${size}`;
---

<span
  class:list={["avatar", sizeClass, cls]}
  data-theme={themeKey}
  aria-hidden="true">{monogram}</span
>
