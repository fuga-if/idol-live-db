---
import Artwork from "./Artwork.astro";
import ColorDot from "./ColorDot.astro";
import Count from "./Count.astro";
import TagChip from "./TagChip.astro";
import Performer from "./Performer.astro";
import type { SetlistRow } from "../lib/schema/SetlistRow";
/**
 * セトリの 1 行。[番号] [ジャケ] [曲名 + 注記 / 札 / 歌唱者]。
 *
 * 札と歌唱者の関係 (全員曲か・オリメンが揃っているか・誰がいなかったか) は Rust が
 * 解いて行に付けてある。ここは来た形を置くだけで、集合を比べ直さない。
 */
interface Props {
  row: SetlistRow;
}
const { row } = Astro.props;

// 歌唱者がこの数を超える行は名前を畳む (全員曲は数に関わらず畳む)。
// 74 人の全体曲を毎行広げると 1 曲で 1 画面を使い、セトリが読めない。純粋に高さの話。
// 畳んでも中身は DOM にあり、JS 無しで開ける (<details>)。
const FOLD_PERFORMERS_OVER = 12;
const folded = row.fullCastLabel !== null || row.performers.length > FOLD_PERFORMERS_OVER;
const Wrap = folded ? "details" : "div";
---

<li class="setlist__row" data-theme={row.song.themeKey}>
  {/* 表示する番号は `row.number` (Rust が公演内で 1 から振ったもの)。
      `row.position` は setlist_items 全体を通した並び順の鍵で、表示用ではない。
      描画側で連番を振らないのは、将来「アンコールは別番号」のような規則が
      入ったときに番号の決め方が 2 実装になるため。 */}
  <span class="setlist__no u-num">{row.number}</span>
  <Artwork title={row.song.name} artworkUrl={row.song.artworkUrl} size="sm" />
  <div class="setlist__main">
    <p class="setlist__head">
      <a class="setlist__title u-underline-hover" href={row.song.path}>{row.song.name}</a>
      {row.notes && <span class="setlist__notes">{row.notes}</span>}
    </p>
    {
      (row.unitLabel || row.isCover || row.lineup) && (
        <p class="u-row" data-lineup={row.lineup?.kind}>
          {row.unitLabel && <TagChip text={row.unitLabel} kind="unit" />}
          {row.isCover && <TagChip text="カバー" kind="cover" />}
          {row.lineup && <TagChip text={row.lineup.label} kind="lineup" />}
          {row.lineup?.missing && (
            <span class="row__meta">
              <span class="lineup__missing-label">{row.lineup.missing.label}</span>
              {row.lineup.missing.idols.map((idol) => (
                <Performer ref={idol} absent />
              ))}
            </span>
          )}
        </p>
      )
    }
    {
      row.performers.length > 0 && (
        <Wrap class:list={[folded && "fold"]}>
          {folded && (
            <summary class="fold__summary">
              {row.fullCastLabel && <TagChip text={row.fullCastLabel} kind="all" />}
              <span class="fold__dots" aria-hidden="true">
                {row.performers.map((p) => (
                  <ColorDot size="md" themeKey={p.ref.themeKey} />
                ))}
              </span>
              <Count value={row.performers.length} unit="人" strong />
              <span class="chevron" aria-hidden="true">›</span>
            </summary>
          )}
          <span class="performers">
            {row.performers.map((p) => (
              <Performer ref={p.ref} castName={p.castName} />
            ))}
          </span>
        </Wrap>
      )
    }
  </div>
</li>
