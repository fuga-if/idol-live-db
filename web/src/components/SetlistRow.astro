---
import Artwork from "./Artwork.astro";
import Fold from "./Fold.astro";
import { setlistAnchorId } from "../lib/anchors";
import Performer from "./Performer.astro";
import type { SetlistRow } from "../lib/schema/SetlistRow";
/**
 * セトリの 1 行 (アプリの `ImasSetlistRow`、DESIGN_SYSTEM §5.6)。
 * [曲順] [ジャケ] [題 / 副題 = 歌唱者 / 下段 = 札と事実]。行の間は切り取り線。
 *
 * 札と歌唱者の関係 (全員曲か・オリメンが揃っているか・誰がいなかったか) は Rust が
 * 解いて行に付けてある。ここは来た形を置くだけで、集合を比べ直さない。
 * 初披露・初歌唱は札にせず、太字 + 曲の色の文字でいちばん強く出す。
 *
 * 衣装も**この披露で着ていたもの**で、曲そのものの属性ではない
 * (同じ曲でも公演が違えば衣装は違う)。記録がある行の方が少ない。
 * 全員曲 (fullCastLabel あり) は人数に関わらず歌唱者を畳む。閾値は Fold が持つ。
 */
interface Props {
  row: SetlistRow;
}
const { row } = Astro.props;
const firsts = [row.firstPerformanceLabel, ...row.newPerformerDebutLabels].filter(
  (l): l is string => typeof l === "string" && l !== "",
);
const hasBadges = !!(row.unitLabel || row.isCover || row.lineup || firsts.length > 0);
---

{/* id は披露履歴 (曲ページ) からの飛び先 (`…/#setlist-N`)。番号は Rust が振ったもの。 */}
<li class="setlist__row" id={setlistAnchorId(row.number)} data-theme={row.song.themeKey}>
  {/* 表示する番号は `row.number` (Rust が公演内で 1 から振ったもの)。
      `row.position` は setlist_items 全体を通した並び順の鍵で、表示用ではない。
      描画側で連番を振らないのは、将来「アンコールは別番号」のような規則が
      入ったときに番号の決め方が 2 実装になるため。 */}
  <span class="setlist__no num num--small">{row.number}</span>
  <Artwork title={row.song.name} artworkUrl={row.song.artworkUrl} size="sm" />
  <div class="setlist__main">
    <p class="setlist__head">
      <a class="setlist__title u-underline-hover" href={row.song.path}>{row.song.name}</a>
      {row.notes && <span class="setlist__notes">{row.notes}</span>}
    </p>
    {
      row.performers.length > 0 && (
        <Fold label="歌唱者" themeKeys={row.performers.map((p) => p.ref.themeKey)} force={row.fullCastLabel !== null}>
          {row.fullCastLabel && <span slot="lead" class="badge">{row.fullCastLabel}</span>}
          <span class="performers">
            {row.performers.map((p) => (
              <Performer ref={p.ref} castName={p.castName} castKind={p.castKind} />
            ))}
          </span>
        </Fold>
      )
    }
    {/* 「いたのに歌わなかった」人は歌唱者の後に控えめに (行の答えは歌唱者の方)。 */}
    {
      row.lineup?.missing && (
        <p class="lineup__missing">
          <span class="lineup__missing-label">{row.lineup.missing.label}</span>
          {row.lineup.missing.idols.map((idol) => (
            <Performer ref={idol} absent />
          ))}
        </p>
      )
    }
    {
      hasBadges && (
        <p class="setlist__tags" data-lineup={row.lineup?.kind}>
          {row.unitLabel && <span class="badge badge--wrap">{row.unitLabel}</span>}
          {row.isCover && <span class="badge">カバー</span>}
          {row.lineup && <span class="badge">{row.lineup.label}</span>}
          {/* 新しい演者での初披露 (「希水しおで初披露」)。初披露と同じ強さで、人数ぶん並ぶ。 */}
          {firsts.map((label) => <span class="setlist__first">{label}</span>)}
        </p>
      )
    }
    {/* 詳細表示だけで見える披露の履歴。軸と文言と主従は Rust が決めてある。 */}
    {
      row.history.length > 0 && (
        <dl class="setlist__history">
          {row.history.map((group) => (
            <div class="setlist__history-axis">
              <dt>{group.label}</dt>
              {group.notes.map((note) => (
                <dd data-tone={note.tone}>{note.text}</dd>
              ))}
            </div>
          ))}
        </dl>
      )
    }
  </div>
</li>
