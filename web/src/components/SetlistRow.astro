---
import Artwork from "./Artwork.astro";
import ColorDot from "./ColorDot.astro";
import TagChip from "./TagChip.astro";
import type { SetlistRow } from "../lib/schema/SetlistRow";
/**
 * セトリの 1 行。曲・ジャケ・この披露限りのユニット表記・カバー・歌唱メンバー・衣装。
 * 歌唱メンバーの表示名 (現任 CV による解決) は Rust が済ませている。
 *
 * 衣装は**この披露で着ていたもの**で、曲そのものの属性ではない
 * (同じ曲でも公演が違えば衣装は違う)。記録がある行の方が少ないので、
 * 無いときは行ごと出さない。
 */
interface Props {
  row: SetlistRow;
}
const { row } = Astro.props;
---

<li class="setlist__row" data-theme={row.song.themeKey}>
  {/* 表示する番号は `row.number` (Rust が公演内で 1 から振ったもの)。
      `row.position` は setlist_items 全体を通した並び順の鍵で、表示用ではない。
      描画側で連番を振らないのは、将来「アンコールは別番号」のような規則が
      入ったときに番号の決め方が 2 実装になるため。 */}
  <span class="setlist__no">{row.number}</span>
  <span class="setlist__body">
    <Artwork title={row.song.name} artworkUrl={row.song.artworkUrl} size="sm" />
    <span class="setlist__main">
      <a class="setlist__title u-underline-hover" href={row.song.path}>{row.song.name}</a>
      {
        (row.unitLabel || row.isCover || row.costumes.length > 0) && (
          <span class="u-row">
            {row.unitLabel && <TagChip text={row.unitLabel} kind="unit" />}
            {row.isCover && <TagChip text="カバー" kind="cover" />}
            {row.costumes.map((c) => (
              /* 着用者の行は共通衣装だと出ない (「全員」とは書かない)。
                 どちらにするかは Rust の `wearers_label` が決めている。 */
              <TagChip text={c.wearersLabel ? `${c.name}（${c.wearersLabel}）` : c.name} kind="costume" />
            ))}
          </span>
        )
      }
      {
        row.performers.length > 0 && (
          <span class="performers">
            {row.performers.map((p) => (
              <a
                class="performer"
                href={p.ref.path}
                data-theme={p.ref.themeKey}
                data-no-cast={p.castName === null ? "true" : undefined}
              >
                {/* **両方の名前を持たせ、どちらを出すかは CSS で切り替える。**
                    表示の規則 (どのモードで何を主/副にするか) は imas-core の
                    `performer_display_name` が持ち、JS は選ばれたモードを
                    ルート要素の data 属性に書くだけ。JS が動かない環境や既定の
                    閲覧者には、サーバが描いたアイドル名がそのまま出る。

                    `castName` が無い = CV 不在 (この判断も Rust 側)。その人は
                    どのモードでもアイドル名のまま出す。 */}
                <ColorDot />
                <span class="performer__names">
                  <span class="performer__idol">{p.ref.name}</span>
                  {p.castName && <span class="performer__cast">{p.castName}</span>}
                </span>
              </a>
            ))}
          </span>
        )
      }
      {row.notes && <span class="setlist__notes">{row.notes}</span>}
    </span>
  </span>
</li>
