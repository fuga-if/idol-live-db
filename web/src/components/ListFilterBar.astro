---
import type { IdolQuery } from "../lib/schema/IdolQuery";
import type { SongQuery } from "../lib/schema/SongQuery";
import type { SortOption } from "../lib/schema/SortOption";

/**
 * 件数と並び順の行 (アプリの `ImasListSummary`、DESIGN_SYSTEM §8.9) + 絞り込みの島 (曲・アイドル共通)。
 *
 *   [2,058 件]                                   [↓ 読み順]
 *
 * 左は件数、右は並び順のメニュー (矢印 + いまの並びの語)。押すと島が起動して操作面
 * (入力欄・並べ替えの札・向き・クリア) がその真下に開く。中身 (軸と値) は Rust が出した素材から
 * island が描く。ここが持つのは器だけで、**どんな軸があるかをこのファイルは知らない**。
 *
 * 並びの語と向きはページが組まれたときのもの (`pageSort`、Rust) を最初から出す。
 * 島が並びを変えたら語と矢印を差し替える。JS が動かない環境ではメニューを押しても何も
 * 起きないので、ボタンは `hidden` で出しておき JS が外す (件数と並びの語は JS 無しでも読める)。
 *
 * 島を起動するのはメニューを押したとき (か URL に条件があるとき) で、
 * それまでは入力欄の器 (`data-filter-controls`) を畳んでおく (Q-14)。開いても閉じても件数の行は残る。
 */
interface Props {
  /** どの一覧か。島の実装をこれで選ぶ。 */
  kind: "songs" | "idols";
  /** 島の絞り込みの土台。Rust が `*ListPage.queryBase` で出す (ページの行を必ず含む条件)。 */
  queryBase: SongQuery | IdolQuery;
  /** ページが値を決めている軸 (島に出さない)。Rust の `*ListPage.fixedAxes`。 */
  fixedAxes: readonly string[];
  total: number;
  /** ページの行が並んでいる順。Rust の `*ListPage.pageSort`。 */
  pageSort: SortOption;
}
const { kind, queryBase, fixedAxes, total, pageSort } = Astro.props;
---

<section
  class="song-filter"
  data-list-filter
  data-filter-kind={kind}
  data-query-base={JSON.stringify(queryBase)}
  data-fixed-axes={JSON.stringify(fixedAxes)}
  data-state="idle"
>
  {/* 件数。絞り込み中は「見えている数 / 全体の数」に島が差し替える。 */}
  <p class="song-filter__status" data-filter-status aria-live="polite">
    <span class="num num--medium">{total.toLocaleString("ja-JP")}</span>
    <span class="num__unit">件</span>
  </p>
  <div class="song-filter__menu">
    <button class="song-filter__open" type="button" data-filter-open aria-expanded="false" hidden>
      <span class="u-visually-hidden">絞り込み・並べ替え: </span>
      <span class="song-filter__arrow" data-filter-arrow aria-hidden="true">{pageSort.defaultAscending ? "↑" : "↓"}</span>
      <span data-filter-sort-label>{pageSort.label}</span>
    </button>
    <div class="song-filter__controls" data-filter-controls hidden>
      <div class="song-filter__fields" data-filter-fields></div>
      <div class="song-filter__row">
        {/* 並べ替えの札。中身 (どの並びがあるか) は island が Rust の素材から描く。 */}
        <div class="song-filter__sorts" role="group" aria-label="並べ替え" data-filter-sorts></div>
        <button class="song-filter__dir" type="button" data-filter-dir aria-label="昇順" disabled>↑</button>
        <button class="song-filter__reset" type="button" data-filter-reset disabled>クリア</button>
      </div>
    </div>
  </div>
  {/* 準備中・失敗の案内。件数の行とは別に、下に 1 行。 */}
  <p class="song-filter__note" data-filter-note aria-live="polite"></p>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-list-filter]");
  if (root) {
    root.querySelector<HTMLElement>("[data-filter-open]")!.hidden = false;
    // 一覧ごとの設定は動的 import で分ける (曲のページにアイドルの設定を配らない)。
    if (root.dataset.filterKind === "idols") {
      const { mountIdolFilter } = await import("../lib/listfilter/idols");
      mountIdolFilter(root);
    } else {
      const { mountSongFilter } = await import("../lib/listfilter/songs");
      mountSongFilter(root);
    }
  }
</script>
