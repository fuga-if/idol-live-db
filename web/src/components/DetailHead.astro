---
/**
 * 詳細の頭 (アプリの `ImasHero` / `ImasMasthead`、DESIGN_SYSTEM §2.2・§6.9)。
 * 全詳細ページで同じ形: 題 (極太) → 副題 (よみ・CV・会場と日付) → 札。
 * 地は紙面のまま。色の地は敷かない。実体の色は題の左の帯 (`.lead-bar`) の 1 か所だけ。
 * 英字の印字 (`LIVE` / `SETLIST`) は情報を持たない装飾なので置かない (2026-10-31)。
 *
 * - 曲のジャケは `lead` スロットで左に置く。
 * - 副題は `sub`、札は `badges`、頭の下に続けたいもの (公演の切替など) は既定のスロット。
 */
interface Props {
  title: string;
  id: string;
  kana?: string | null;
  /** 題の左の帯 (実体の色) を出すか。色を持たないページ (neutral) では出さない。 */
  bar?: boolean;
  /** 題を別のリンクにする (公演ページの題 = ライブ名)。 */
  titleHref?: string;
}
const { title, id, kana, bar = true, titleHref } = Astro.props;
const hasLead = Astro.slots.has("lead");
const hasSub = Astro.slots.has("sub");
const hasBadges = Astro.slots.has("badges");
const hasAfter = Astro.slots.has("default");
---

<header class:list={["dhead", hasLead && "dhead--lead"]} aria-labelledby={id}>
  {
    hasLead && (
      <div class="dhead__lead">
        <slot name="lead" />
      </div>
    )
  }
  <div class="dhead__body">
    <div class="dhead__titlerow">
      {bar && <span class="lead-bar" aria-hidden="true"></span>}
      <h1 class="dhead__title" id={id}>
        {titleHref ? <a class="u-underline-hover" href={titleHref}>{title}</a> : title}
      </h1>
    </div>
    {kana && <p class="dhead__kana">{kana}</p>}
    {
      hasSub && (
        <div class="dhead__sub">
          <slot name="sub" />
        </div>
      )
    }
    {
      hasBadges && (
        <div class="dhead__badges">
          <slot name="badges" />
        </div>
      )
    }
    {hasAfter && <slot />}
  </div>
</header>
