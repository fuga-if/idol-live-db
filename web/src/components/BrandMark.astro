---
import type { Ref } from "../lib/schema/Ref";
/**
 * ブランドの小さな札 — 名前だけ。**名前の前に色の点は置かない** (DESIGN_SYSTEM §1-3:
 * 幅を取るだけで、名前が何かを言っている。色は行頭の帯・入場証の帯に出す)。
 * 行のメタ (`short`: 短縮名) と注目カードの小見出し (フル名) で使う。
 * 名前そのものは Rust の `Ref` (`name` / `sub` = 短縮名) から取る。
 */
interface Props {
  brand: Ref;
  short?: boolean;
}
const { brand, short = false } = Astro.props;
---

<span class="brand-mark" data-theme={brand.themeKey}>
  {short ? (brand.sub ?? brand.name) : brand.name}
</span>
