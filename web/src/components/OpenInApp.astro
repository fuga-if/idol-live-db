---
import type { AppOpen } from "../lib/schema/AppOpen";
/**
 * 「アプリで開く」導線 (アプリの `ImasEntryCard` の形、DESIGN_SYSTEM §6.4)。
 * 記号 (アプリのアイコン) は地なし、題 + 説明、紙の面。
 * ユーザー指示により、状態を持つ機能 (参加記録・投票・歌詞・タグ・コール) はすべて
 * アプリ側なので、詳細ページから必ずここへ誘導する。
 * 文面 (`note`) と deeplink の有無は Rust が決める。主ボタンは deeplink がある 1 つだけ。
 */
interface Props {
  app: AppOpen;
}
const { app } = Astro.props;
---

<aside class="open-in-app" aria-label="アプリで開く">
  <img
    class="open-in-app__icon"
    src="/icon-192.png"
    alt=""
    width="48"
    height="48"
    loading="lazy"
    decoding="async"
  />
  <div class="open-in-app__body">
    <p class="open-in-app__title">{app.title}</p>
    <p class="open-in-app__note">{app.note}</p>
  </div>
  <div class="open-in-app__actions">
    {app.deeplink && <a class="btn" href={app.deeplink}>アプリで開く</a>}
    <a class="btn btn--ghost" href={app.appStoreUrl}>App Store</a>
  </div>
</aside>
