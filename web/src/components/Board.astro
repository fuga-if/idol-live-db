---
import type { StatTile } from "../lib/schema/StatTile";
/**
 * 電光掲示板 (アプリの `ImasBoard`、DESIGN_SYSTEM §6.7)。
 * 記録・収録の数を暗い板に細長い数字で並べる。上の行は印字 (`STATS`)。
 * ライトでもダークでも板は暗い。
 *
 * どの数を何の順で出すかは Rust の `StatTile` が決める。記号 (`glyph`) はここでは出さない。
 */
interface Props {
  title?: string;
  trailing?: string;
  cells: readonly StatTile[];
  label?: string;
}
const { title, trailing, cells, label } = Astro.props;
---

{
  cells.length > 0 && (
    <div class="board" role="group" aria-label={label}>
      {(title || trailing) && (
        <div class="board__head" aria-hidden="true">
          <span class="imprint">{title}</span>
          <span class="imprint">{trailing}</span>
        </div>
      )}
      <div class="board__cells">
        {cells.map((c) =>
          c.href ? (
            <a class="board__cell" href={c.href}>
              <span class="board__value">
                <span class="num num--large">{c.value.toLocaleString("ja-JP")}</span>
              </span>
              <span class="board__label">{c.label}</span>
            </a>
          ) : (
            <div class="board__cell">
              <span class="board__value">
                <span class="num num--large">{c.value.toLocaleString("ja-JP")}</span>
              </span>
              <span class="board__label">{c.label}</span>
            </div>
          ),
        )}
      </div>
    </div>
  )
}
