---
/**
 * アイドルカラーの点 (アプリの ColorDot と同じ役割)。
 *
 * 誰の行かを色で見分けるための印。**色は書かない** — 囲んでいる要素の
 * `data-theme` から themes.css が `--accent` を与える。
 *
 * 版権物ゼロなので絵は持てず、色だけが「顔」になる。大きさは置き場ごとに
 * ここで指名する (`avatar` = タイルの顔、`hero` = 詳細ページの顔)。
 * 祖先のセレクタで大きさを変えない — 部品を動かしたときに黙って変わる。
 */
interface Props {
  size?: "sm" | "md" | "avatar" | "hero";
}
const { size = "sm" } = Astro.props;
const sizeClass = size === "sm" ? "" : `color-dot--${size}`;
---

<span class:list={["color-dot", sizeClass]} aria-hidden="true"></span>
