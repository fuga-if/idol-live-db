---
/**
 * アイドルカラーの点 (アプリの ColorDot と同じ役割)。
 *
 * 誰の行かを色で見分けるための印。**色は書かない** — 囲んでいる要素の
 * `data-theme` から themes.css が `--accent` を与える。
 *
 * 版権物ゼロなので絵は持てず、色だけが「顔」になる。
 */
interface Props {
  size?: "sm" | "lg";
}
const { size = "sm" } = Astro.props;
---

<span class:list={["color-dot", size === "lg" && "color-dot--lg"]} aria-hidden="true"></span>
