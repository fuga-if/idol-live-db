---
/**
 * アイドルカラーの点 (アプリの ColorDot と同じ役割)。
 *
 * 誰の行かを色で見分けるための印。**色は書かない** — 囲んでいる要素の
 * `data-theme` から themes.css が `--accent` を与える。
 *
 * アイドルの「顔」としては使わない (顔写真は版権物で持てず、代わりの丸も置かない)。
 * 大きさは置き場ごとにここで指名する。祖先のセレクタで大きさを変えない —
 * 部品を動かしたときに黙って変わる。
 */
interface Props {
  size?: "sm" | "md";
  /** 囲む要素が無いとき (点だけを並べるとき) は、点自身に `data-theme` を持たせる。 */
  themeKey?: string;
}
const { size = "sm", themeKey } = Astro.props;
---

<span class:list={["color-dot", size === "md" && "color-dot--md"]} data-theme={themeKey} aria-hidden="true"></span>
