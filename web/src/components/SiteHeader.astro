---
import { meta } from "../lib/data";
import type { Crumb } from "../lib/schema/Crumb";
/**
 * サイト共通ナビ (上部バー)。現在地は **ページのパンくず** で決まる (状態は持たない):
 * パンくずにそのリンクの path が居れば現在地。「公演はライブの下」のような所属の判断は
 * Rust がパンくずを組むときに 1 回だけしている (ここでパスの接頭辞を見直さない)。
 *
 * **並びは Rust が出す** (`meta.primaryNav`)。
 * 広い画面では ロゴ / 一覧 / 検索欄 の 1 段。狭い画面では ロゴと虫眼鏡だけにして、
 * 一覧は画面下のタブバー (SiteTabBar) に任せる。切り替えは base.css のメディアクエリだけ。
 * 検索は入力欄の形をしたリンク (/search/ で本物の入力欄が待つ)。
 */
interface Props {
  crumbs: readonly Crumb[];
}
const { crumbs } = Astro.props;
const { primaryNav: nav, siteName } = meta();
const here = new Set(crumbs.map((c) => c.path));
const isCurrent = (href: string) => here.has(href);
---

<header class="site-nav">
  <div class="site-nav__inner">
    <a class="site-nav__brand" href="/">
      <img class="site-nav__mark" src="/logo-mark.png" alt="" width="30" height="30" />
      <span>{siteName}</span>
    </a>
    <nav class="site-nav__links" aria-label="サイト内の主要な一覧">
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={n.path} aria-current={isCurrent(n.path) ? "page" : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a
      class="site-nav__search"
      href="/search/"
      aria-current={isCurrent("/search/") ? "page" : undefined}
    >
      <svg class="site-nav__search-glyph" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
      <span class="site-nav__search-text">曲・アイドル・ライブを検索</span>
    </a>
  </div>
</header>
