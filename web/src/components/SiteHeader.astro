---
/**
 * サイト共通ナビ。現在地はパス接頭辞で決まる (状態は持たない)。
 *
 * マークアップは 1 つで、**広い画面ではサイドバー / 狭い画面では上部の横スクロールバー**に
 * なる。切り替えは base.css のメディアクエリだけで、JS は 1 行も要らない。
 * 一覧が 6 つあり、横 1 列に並べると幅の割に窮屈で、しかも項目が増やせない。
 */
interface Props {
  pathname: string;
}
const { pathname } = Astro.props;
const nav = [
  { name: "ライブ", href: "/events/" },
  { name: "楽曲", href: "/songs/" },
  { name: "アイドル", href: "/idols/" },
  { name: "ユニット", href: "/units/" },
  { name: "会場", href: "/venues/" },
  { name: "ブランド", href: "/brands/" },
];
const isCurrent = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<div class="site-nav">
  <a class="site-nav__brand" href="/">
    <img
      class="site-nav__mark"
      src="/icon-192.png"
      alt=""
      width="26"
      height="26"
    />
    アイドルライブDB
  </a>
  <a class="site-nav__search" href="/search/">
    <span aria-hidden="true">⌕</span>検索
  </a>
  <nav class="site-nav__links" aria-label="サイト内の主要な一覧">
    <p class="site-nav__label">一覧</p>
    <ul>
      {
        nav.map((n) => (
          <li>
            <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>
              {n.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
