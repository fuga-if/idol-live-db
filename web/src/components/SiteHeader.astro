---
import { meta } from "../lib/data";
/**
 * サイト共通ナビ (上部バー)。現在地はパス接頭辞で決まる (状態は持たない)。
 *
 * **並びは Rust が出す** (`meta.primaryNav`)。お題ページは焼き込んだ集計が
 * 空だと書き出されないので、その条件を知っている側がリンクの有無も決める。
 * 広い画面では 1 段、狭い画面では「ブランド + 検索」の下に横スクロールの一覧。
 * 切り替えは base.css のメディアクエリだけで、JS は 1 行も要らない。
 */
interface Props {
  pathname: string;
}
const { pathname } = Astro.props;
const nav = meta().primaryNav;
const isCurrent = (href: string) => pathname.startsWith(href);
---

<header class="site-nav">
  <div class="site-nav__inner">
    <a class="site-nav__brand" href="/">
      <img class="site-nav__mark" src="/icon-192.png" alt="" width="28" height="28" />
      アイドルライブDB
    </a>
    <nav class="site-nav__links" aria-label="サイト内の主要な一覧">
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={n.path} aria-current={isCurrent(n.path) ? "page" : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a
      class="site-nav__search"
      href="/search/"
      aria-current={isCurrent("/search/") ? "page" : undefined}
    >
      <span class="site-nav__search-glyph" aria-hidden="true">⌕</span>検索
    </a>
  </div>
</header>
