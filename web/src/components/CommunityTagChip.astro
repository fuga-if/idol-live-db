---
/**
 * コミュニティのタグの札 1 枚 (曲ページの「みんなの記録」・タグ一覧・タグページで同じ見た目)。
 *
 * 色はタグ自身のテーマ (`themes.css` の `tag:<id>`)。自分の色を持つタグだけ先頭に色見本 `.swatch`
 * を置く。自分の色を持たないタグは `themeKey` が無く、見本も無い (囲む要素の色を継がない)。**hex は来ない** — インライン style は
 * CSP (`style-src 'self'`) で効かないので、色はすべて `data-theme` から引く。
 * `href` があれば押せる (曲のタグ = 一覧がある)。無ければ押せない札 (アイドル・ユニットのタグ)。
 * どちらかは Rust が `path` の有無で決めている。
 */
interface Props {
  tag: { name: string; themeKey: string | null; isOfficial: boolean };
  href?: string | null;
  /** 何人が付けたか。曲ページの札だけ出す。 */
  count?: number | null;
}
const { tag, href, count } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag
  class:list={["chip", "chip--tag", tag.isOfficial && "chip--official", href && "u-underline-hover"]}
  data-theme={tag.themeKey}
  href={href}
>
  {/* 色そのものが中身のタグだけ、先頭に色見本 (DESIGN_SYSTEM §8.2)。 */}
  {tag.themeKey && <span class="swatch" aria-hidden="true"></span>}
  {tag.name}
  {count !== undefined && count !== null && <b class="num num--small chip__count">{count.toLocaleString("ja-JP")}</b>}
</Tag>
