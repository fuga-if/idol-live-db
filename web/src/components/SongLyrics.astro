---
import type { LyricsBlock } from "../lib/schema/LyricsBlock";

/**
 * 歌詞とコールガイド。使われ方はコールガイド目的が多いので、ボタンの文言 (Rust) も両方を言う。
 *
 * **出すかどうかを決めるのはここではない。** `imas-core` の
 * `content::LYRICS_ON_WEB` が決めた結果が `lyrics.available` で来る。
 * false の間は取得先も許諾番号も配られないので、この器は案内文だけを出す。
 *
 * 出すときの決まり (JASRAC 非商用配信の許諾):
 * - **許諾番号を見える位置に掲示する。**
 * - **まとめて取れない形にする。** 取りに行くのは押されたときの 1 曲だけで、
 *   静的な HTML には 1 文字も入っていない。
 * - **回数が数えられる。** Worker が 1 リクエストごとに記録する
 *   (年次利用曲目報告の母集団)。だから共有キャッシュにも載せない。
 * - コピーを取りにくくする。選択 (CSS)・コピー・ドラッグ・印刷を抑える。
 *   完全には防げないが「一括ダウンロード不可」の実効性を担保する形にする。
 *   右クリックと selectstart までは止めない: 読み上げ・辞書・拡大のような支援の道具を
 *   殺すだけで、ソースを見る人には何の障害にもならない。
 *
 * コールは**位置で示す** (実物のコール表と同じ組み方):
 * - 同時 (歌に被せる) は、アンカーした語の**真下**。追っかけは語の**後ろ** (右端から)。
 * - 掛かる範囲の無いコール (行末に足したもの) は、その位置 (ふつう行末)。
 * 歌詞の本文は普通に折り返し、コールは本文の流れに影響しない**重ね書き** (絶対配置) で
 * 語の真下に置く。語とコールを 1 塊にすると、コールの長さぶん歌詞が広がり、狭い画面では
 * 語だけが次の行に落ちて読めなくなった。位置は描画後に語の矩形から測って決め、
 * 画面幅が変わったら測り直す。コールが重なるときは右へずらし、入らなければ段を足す。
 * 記号・凡例の語は Rust (`content::call_guide_vocabulary`) が `lyrics.callGuide` で配り、
 * ここは位置 (Unicode スカラー単位の start/end) と突き合わせて置くだけ。
 *
 * 本文の字の置き方はアプリ (iOS/Android の歌詞タブ) と同じ。決めるのは Rust
 * (`lyric_line_display`、ブラウザの wasm で呼ぶ。`lib/lyrics/display.ts`) で、ここは置くだけ:
 * - 振り仮名 (`親字《よみ》`) は記号を外し、読みを親字の上に (`<ruby>`)。
 * - 括弧で書いた脇の字 (被せ・コーラス) は一段小さく薄く。
 * - パート分けのある曲 (原唱者 2 人以上、`lyrics.partCast`) は、字を歌う人の担当色で塗る
 *   (何人かで歌う字は上から歌う人の順に縞で塗り分ける。境目はくっきり、ぼかさない)。
 *   行の下に歌う人の名前を添える (色だけに頼らない)。
 * - 歌詞と同じ文字のコールは行に並べず、歌詞のその部分を濃く敷いて太字にする。
 */
interface Props {
  lyrics: LyricsBlock;
}
const { lyrics } = Astro.props;
---

{
  lyrics.available && lyrics.sourceUrl ? (
    <div
      class="lyrics"
      data-lyrics
      data-source={lyrics.sourceUrl}
      data-call-guide={lyrics.callGuide ? JSON.stringify(lyrics.callGuide) : undefined}
      data-part-cast={lyrics.partCast.length > 0 ? JSON.stringify(lyrics.partCast) : undefined}
      data-share-theme={lyrics.shareThemeKey}
    >
      <p class="note lyrics__license">{lyrics.licenseNote}</p>
      <button class="btn" type="button" data-lyrics-load>
        {lyrics.readLabel}
      </button>
      {/* 最初から木に居る (display:none の live region は最初の変化が読まれないことがある)。 */}
      <p class="note lyrics__status" data-lyrics-status role="status" aria-live="polite" />
      {/* 本文はここに描かれる。サーバから配る HTML には入っていない。
          読み込んだらここへフォーカスを移す (押したボタンが消えて焦点が迷子にならない)。 */}
      <div class="lyrics__body" data-lyrics-body tabindex="-1" aria-labelledby="song-lyrics" hidden />
      {/* 歌詞の一部へのリンクの共有。選び方の案内は読み込んだあとに出す (語は指の種類で変わる)。 */}
      <p class="note lyrics__share-hint" data-lyrics-share-hint hidden />
      <div class="lyrics-share" data-lyrics-share data-theme={lyrics.shareThemeKey} role="region" aria-label="選んだ歌詞の共有" hidden>
        <p class="lyrics-share__what">
          <span class="lyrics-share__lines" data-lyrics-share-lines />
          <span class="lyrics-share__sub">この部分へのリンク</span>
        </p>
        <button class="btn btn--ghost lyrics-share__copy" type="button" data-lyrics-share-copy>リンクをコピー</button>
        <button class="btn lyrics-share__native" type="button" data-lyrics-share-native hidden>共有</button>
        <button class="lyrics-share__close" type="button" data-lyrics-share-close aria-label="選択を解除">×</button>
      </div>
    </div>
  ) : (
    <div class="lyrics lyrics--pending">
      {lyrics.statusLabel && <span class="badge lyrics__pending">{lyrics.statusLabel}</span>}
      <p class="note">{lyrics.note}</p>
    </div>
  )
}

<script>
  import type { CallGuideVocabulary } from "../lib/schema/CallGuideVocabulary";
  import type { LyricPartCastMember } from "../lib/schema/LyricPartCastMember";
  import { lyricLinesDisplay, type LyricLineDisplay, type LyricRun } from "../lib/lyrics/display";

  /** Worker が返す歌詞 1 曲。本文はここでしか扱わない。 */
  interface LyricCall {
    id: string;
    /** 行内の位置 (Unicode スカラー単位、end は排他)。start === end は行末 (掛かる範囲が無い)。 */
    start: number;
    end: number;
    text: string;
    emphasis?: string | null;
    timing?: string | null;
    stale?: boolean | null;
    /** "penlight" はペンライトの指示 (ペンラ芸)。text は代わりの文言 (読み上げに使う)。 */
    kind?: string | null;
    penlight?: { color?: string | null; note?: string | null } | null;
  }
  interface LyricLine {
    kind?: string | null;
    text: string;
    clap?: string | null;
    calls?: LyricCall[] | null;
  }
  /** 縞で塗り分ける色の上限 (全体曲で全員の色を重ねると縞が細すぎて読めない。アプリと同じ 4)。 */
  const PART_COLORS_MAX = 4;

  const root = document.querySelector<HTMLElement>("[data-lyrics]");
  const source = root?.dataset.source;
  if (root && source) {
    const button = root.querySelector<HTMLButtonElement>("[data-lyrics-load]")!;
    const status = root.querySelector<HTMLElement>("[data-lyrics-status]")!;
    const body = root.querySelector<HTMLElement>("[data-lyrics-body]")!;
    const vocabulary: CallGuideVocabulary | null = root.dataset.callGuide
      ? (JSON.parse(root.dataset.callGuide) as CallGuideVocabulary)
      : null;
    const cast: LyricPartCastMember[] = root.dataset.partCast
      ? (JSON.parse(root.dataset.partCast) as LyricPartCastMember[])
      : [];
    const castById = new Map(cast.map((m) => [m.id, m]));
    const hint = root.querySelector<HTMLElement>("[data-lyrics-share-hint]")!;
    /** 指で触る端末か (選び方の案内と、共有ボタンの主従が変わる)。 */
    const coarse = window.matchMedia("(pointer: coarse)");
    const scalars = (text: string): number => Array.from(text).length;

    /** 描いた行と、行ごとの字のひと続き (元の本文の位置と、置いた文字ノード)。選択と共有に使う。 */
    interface PlacedRun {
      start: number;
      end: number;
      node: Text;
      /** 字と元の位置が 1:1 (振り仮名や記号を外した字は丸ごとでしか選ばない)。 */
      exact: boolean;
    }
    const lineEls: HTMLElement[] = [];
    const lineRuns: PlacedRun[][] = [];
    const lineLengths: number[] = [];
    let placingRuns: PlacedRun[] = [];
    /** 選んだ範囲の塗り (字の下に敷く層)。色は曲の歌い手 (Rust の shareThemeKey)。 */
    const marks = document.createElement("span");
    marks.className = "lyrics__marks";
    marks.setAttribute("aria-hidden", "true");
    if (root.dataset.shareTheme) marks.dataset.theme = root.dataset.shareTheme;

    // コピーを取りにくくする。コピー・切り取り・ドラッグを止める (選択は CSS、印刷も CSS)。
    // 完全には防げないが、まとめ取りの手間を上げる。
    for (const type of ["copy", "cut", "dragstart"]) {
      body.addEventListener(type, (e) => e.preventDefault());
    }

    const say = (text: string) => {
      status.textContent = text;
    };

    const el = (tag: string, className: string, text?: string): HTMLElement => {
      const node = document.createElement(tag);
      node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    };

    /** 強調度の強さ。同じ範囲に複数のコールがあるとき、行内に敷く色は一番強いものにする。 */
    const rank = (emphasis: string | null | undefined): number =>
      emphasis === "performer_request" ? 2 : emphasis === "optional" ? 1 : 0;
    const hasAnchor = (c: LyricCall): boolean => c.end > c.start;
    const isOver = (c: LyricCall): boolean => c.timing === "over" && hasAnchor(c);

    /**
     * コールの置き場所 (スロット)。同時は語の範囲 (真下に置く)、追っかけと行末は
     * 位置 1 点 (その右に置く)。同じ場所のコールは 1 段にまとめる。
     */
    interface Slot {
      start: number;
      end: number;
      calls: LyricCall[];
    }
    const slotsOf = (calls: LyricCall[]): Slot[] => {
      const byKey = new Map<string, Slot>();
      for (const c of calls) {
        const start = isOver(c) ? c.start : c.end;
        const end = isOver(c) ? c.end : c.end;
        const key = `${start}-${end}`;
        const slot = byKey.get(key) ?? { start, end, calls: [] };
        slot.calls.push(c);
        byKey.set(key, slot);
      }
      return [...byKey.values()].sort((a, b) => a.start - b.start || a.end - b.end);
    };

    /** 行ごとのコールと目印の対。配置は描画後に目印の矩形から決める (`placeCalls`)。 */
    interface CallSlot {
      marker: HTMLElement;
      call: HTMLElement;
      /** 同時 (語の真下に置く) か。false は追っかけ・行末 (目印の右に置く)。 */
      over: boolean;
    }
    const lineSlots = new WeakMap<HTMLElement, CallSlot[]>();

    /** 1 スロットぶんのコール (複数なら空白で 1 段に並べる)。 */
    /**
     * ペンライトの指示 1 つ: 棒 (色の面。光らせない) + メモ。色は data 属性と CSSOM で塗る
     * (style 属性は本番の CSP で落ちる)。アイドルの色はその人のテーマ、担当色は縞。
     */
    const penlightItem = (c: LyricCall): HTMLElement => {
      const item = el("span", "lyrics__call-item lyrics__penlight");
      item.setAttribute("role", "img");
      item.setAttribute("aria-label", c.text);
      const stick = el("span", "lyrics__penlight-stick");
      const color = c.penlight?.color ?? "";
      if (color === "oshi") stick.dataset.fill = "oshi";
      else if (color.startsWith("idol:")) {
        const theme = castById.get(color.slice(5))?.themeKey;
        if (theme) {
          stick.dataset.fill = "theme";
          stick.dataset.theme = theme;
        }
      } else if (/^#[0-9A-Fa-f]{6}$/.test(color)) {
        stick.dataset.fill = "fixed";
        stick.style.backgroundColor = color;
      }
      item.append(stick);
      if (c.penlight?.note) item.append(el("span", "lyrics__penlight-note", c.penlight.note));
      return item;
    };

    const callRow = (slot: Slot): HTMLElement => {
      const row = el("span", "lyrics__call");
      slot.calls.forEach((c, i) => {
        if (i > 0) row.append(" ");
        if (c.kind === "penlight" && c.penlight) {
          row.append(penlightItem(c));
          return;
        }
        const item = el("span", `lyrics__call-item lyrics__call-item--${c.emphasis ?? "normal"}`, c.text);
        if (c.stale && hasAnchor(c) && vocabulary) {
          item.append(" ", el("span", "lyrics__tag", vocabulary.staleLabel));
        }
        row.append(item);
      });
      return row;
    };

    /**
     * 字のひと続き 1 つ。振り仮名は `<ruby>`、脇の字は一段小さく、歌う人は担当色。
     * 何人かで歌う字は、歌う人ごとのテーマを外側から入れ子にして `--p1`… に色を取り
     * (各テーマの `--accent` を、その層で値にして受け継ぐ)、内側で縞に塗る。
     */
    const runNode = (run: LyricRun): Node => {
      const themes = run.singers
        .map((id) => castById.get(id)?.themeKey)
        .filter((t): t is string => !!t)
        .slice(0, PART_COLORS_MAX);
      const text = document.createTextNode(run.text);
      placingRuns.push({ start: run.start, end: run.end, node: text, exact: !run.ruby && scalars(run.text) === run.end - run.start });
      if (!run.ruby && !run.aside && themes.length === 0) return text;
      const node = el("span", run.aside ? "lyrics__run lyrics__run--aside" : "lyrics__run");
      if (run.ruby) {
        const ruby = document.createElement("ruby");
        ruby.append(text, el("rt", "lyrics__ruby", run.ruby));
        node.append(ruby);
      } else {
        node.append(text);
      }
      const [only] = themes;
      if (themes.length === 1 && only) {
        node.dataset.theme = only;
        node.dataset.part = "";
        return node;
      }
      if (themes.length === 0) return node;
      node.dataset.stripes = String(themes.length);
      let outer: HTMLElement = node;
      // 内側から外へ包む (層の番号は歌う人の並び。どの層も自分のテーマの --accent を値にして受け継ぐ)。
      for (const [i, theme] of [...themes.entries()].reverse()) {
        const layer = el("span", `lyrics__part-layer lyrics__part-layer--${i + 1}`);
        layer.dataset.theme = theme;
        layer.append(outer);
        outer = layer;
      }
      return outer;
    };

    /**
     * 本文。アンカー範囲 (追っかけの分も含む) は薄く色を敷き、スロットの位置に目印
     * (範囲は mark そのもの、1 点は幅ゼロの span) を置く。コールは重ね書きの層に出し、
     * 位置は描画後に目印の矩形から決める。重なる範囲は先勝ち。位置はスカラー単位。
     * 字はひと続き (`display.runs`) ごとに置く。ひと続きはコールの端で切れているので、
     * 範囲の中に丸ごと入るか外にあるかのどちらか (振り仮名の親字の途中だけは切らない)。
     * 歌詞と同じ文字のコール (`echo`) は行に並べず、範囲を濃く敷いて太字にする。
     */
    const lineContent = (calls: LyricCall[], display: LyricLineDisplay): HTMLElement => {
      const runs = display.runs;
      const length = runs.at(-1)?.end ?? 0;
      const content = el("span", "lyrics__content");
      const textEl = el("span", "lyrics__text");
      const overlay = el("span", "lyrics__overlay");
      const listed = calls.filter((_, i) => !display.echoes[i]);
      const tint = new Map<string, { start: number; end: number; emphasis: string; echo: boolean }>();
      calls.forEach((c, i) => {
        if (!hasAnchor(c)) return;
        const key = `${c.start}-${c.end}`;
        const emphasis = c.emphasis ?? "normal";
        const echo = display.echoes[i] === true;
        const current = tint.get(key);
        if (!current) tint.set(key, { start: c.start, end: c.end, emphasis, echo });
        else {
          if (rank(emphasis) > rank(current.emphasis)) current.emphasis = emphasis;
          current.echo ||= echo;
        }
      });
      interface Piece {
        start: number;
        end: number;
        emphasis?: string;
        echo?: boolean;
        slot?: Slot;
      }
      const pieces: Piece[] = [...tint.values()];
      for (const slot of slotsOf(listed)) {
        const same = pieces.find((p) => p.start === slot.start && p.end === slot.end && !p.slot);
        if (same && slot.end > slot.start) same.slot = slot;
        else pieces.push({ start: slot.start, end: slot.end, slot });
      }
      pieces.sort((a, b) => a.start - b.start || a.end - b.end);

      const slots: CallSlot[] = [];
      let next = 0; // まだ置いていないひと続き
      /** `before` より前から始まるひと続きを `into` に置いていく。 */
      const placeRuns = (into: HTMLElement, before: number) => {
        for (let run = runs[next]; run && run.start < before; run = runs[++next]) into.append(runNode(run));
      };
      for (const piece of pieces) {
        const start = Math.min(piece.start, length);
        const end = Math.min(Math.max(piece.end, start), length);
        placeRuns(textEl, start);
        let marker: HTMLElement | null = null;
        if (end > start) {
          const mark = el("mark", "lyrics__anchor");
          placeRuns(mark, end);
          if (mark.childNodes.length > 0) {
            mark.dataset.emphasis = piece.emphasis ?? "normal";
            if (piece.echo) mark.dataset.echo = "";
            marker = mark;
          }
        }
        // 幅ゼロの目印。中身はゼロ幅スペース (空の span は矩形を持たない)。
        // 範囲が先の範囲に食われて空になったときも、ここに置く。
        if (!marker) marker = el("span", "lyrics__point", "\u200b");
        if (piece.slot) {
          const call = callRow(piece.slot);
          overlay.append(call);
          slots.push({ marker, call, over: marker.tagName === "MARK" && piece.slot.end > piece.slot.start });
        }
        textEl.append(marker);
      }
      placeRuns(textEl, Infinity);
      content.append(textEl);
      if (slots.length > 0) {
        content.dataset.hasCalls = "";
        content.append(overlay);
        lineSlots.set(content, slots);
      }
      return content;
    };

    /** 行の下に添える歌う人の名前 (「未来・静香」、途中で変わる行は「未来 → 静香」)。 */
    const partNames = (display: LyricLineDisplay): HTMLElement | null => {
      const groups = display.partGroups
        .map((g) => g.map((id) => castById.get(id)?.name).filter((n): n is string => !!n))
        .filter((g) => g.length > 0);
      if (groups.length === 0) return null;
      const names = el("span", "lyrics__parts", groups.map((g) => g.join("・")).join(" → "));
      names.setAttribute("aria-label", `歌唱 ${groups.map((g) => g.join("、")).join("、つづいて ")}`);
      return names;
    };

    /** wasm が読めないときの置き方 (本文を 1 字ずつそのまま。印を付けない)。 */
    const plainDisplay = (line: LyricLine): LyricLineDisplay => ({
      runs: Array.from(line.text).map((text, i) => ({ start: i, end: i + 1, text, ruby: null, aside: false, singers: [] })),
      echoes: (line.calls ?? []).map(() => false),
      partGroups: [],
    });

    /**
     * コールの位置を語の矩形から決める。
     * - 同時: 語の先頭の x、追っかけ・行末: 目印の右端の x。y はその表示行の直下。
     * - 右端に入らなければ左へ寄せる (語の色で対応は分かる)。行幅より長いコールは行頭から折り返す。
     * - 同じ表示行で重なるコールは右へずらし、右端に入らなければ 1 段下げる。
     * - 折り返した段落の途中の行の下に置いたコールが次の行の本文に食い込むなら、その深さぶん
     *   行送りを広げて (`--band`) 置き直す。行送りは上下に均等に割られるので、行と行の間は
     *   ちょうど帯のぶん開く (1 回で収まる)。最後の行の下は余白で受ける。
     * 読み (矩形) と書き (スタイル) は段落ごとにまとめ、1 回の配置の再レイアウトを 2 回に抑える。
     */
    const CALL_GAP = 2; // 語の下端とコールの間
    const AFTER_GAP = 4; // 追っかけ・行末: 目印の右端からの間
    const SIDE_GAP = 6; // 同じ行に並ぶコール同士の間
    const LINE_GAP = 4; // 途中の行に置いたコールと、次の行の本文の間
    interface Box {
      left: number;
      right: number;
      top: number;
      bottom: number;
    }

    const placeCalls = (content: HTMLElement, slots: CallSlot[], band: number) => {
      // 書き: 前回の配置を戻す (画面幅が変わったときに測り直すため)。
      content.style.setProperty("--band", `${band}px`);
      content.style.paddingBlockEnd = "";
      for (const s of slots) {
        delete s.call.dataset.wrap;
        s.call.style.maxInlineSize = "";
      }
      // 読み: 語の矩形と、コールの自然な幅。
      const origin = content.getBoundingClientRect();
      const width = content.clientWidth;
      const textRects = [...content.querySelector(".lyrics__text")!.getClientRects()];
      const measured = slots.map((s) => {
        const rects = s.marker.getClientRects();
        return {
          ...s,
          rect: s.over ? rects[0] : rects[rects.length - 1],
          width: s.call.offsetWidth,
          height: 0,
          left: 0,
          top: 0,
        };
      });
      // 書き → 読み: 行幅より長いコールは行頭から折り返し、その高さを測る。
      for (const m of measured) {
        if (m.width > width) {
          m.call.dataset.wrap = "";
          m.call.style.maxInlineSize = `${width}px`;
          m.width = width;
        }
      }
      for (const m of measured) m.height = m.call.offsetHeight;

      const placed: Box[] = [];
      let intrusion = 0;
      let overflow = 0;
      for (const m of measured) {
        if (!m.rect) continue;
        const anchorLeft = (m.over ? m.rect.left : m.rect.right + AFTER_GAP) - origin.left;
        const fit = (x: number) => Math.max(0, Math.min(x, width - m.width));
        let left = fit(anchorLeft);
        let top = m.rect.bottom - origin.top + CALL_GAP;
        // 同じ行で重なるなら右へ。右端に入らなければ 1 段下げる (毎回右か下へ進むので必ず終わる)。
        for (;;) {
          const hit = placed.find(
            (b) => top < b.bottom && top + m.height > b.top && left < b.right && left + m.width > b.left,
          );
          if (!hit) break;
          if (hit.right + SIDE_GAP + m.width <= width) left = hit.right + SIDE_GAP;
          else {
            left = fit(anchorLeft);
            top = hit.bottom + CALL_GAP;
          }
        }
        placed.push({ left, right: left + m.width, top, bottom: top + m.height });
        m.left = left;
        m.top = top;
        // 後ろの行の本文 (同じ x の範囲) に食い込む深さ。
        const absLeft = origin.left + left;
        const absBottom = origin.top + top + m.height;
        for (const t of textRects) {
          if (t.top > m.rect.bottom + 1 && t.left < absLeft + m.width && t.right > absLeft) {
            intrusion = Math.max(intrusion, absBottom + LINE_GAP - t.top);
          }
        }
        overflow = Math.max(overflow, top + m.height - origin.height);
      }
      // 書き: 置く。
      for (const m of measured) {
        if (m.rect) m.call.style.translate = `${m.left}px ${m.top}px`;
      }
      return { intrusion, overflow };
    };

    let laidOutWidth = -1;
    const layoutCalls = (force = false): void => {
      // 自分の余白で高さだけ変わったとき (幅が同じ) は置き直さない。
      const width = body.clientWidth;
      if (!force && width === laidOutWidth) return paintPick();
      laidOutWidth = width;
      for (const content of body.querySelectorAll<HTMLElement>(".lyrics__content[data-has-calls]")) {
        const slots = lineSlots.get(content);
        if (!slots) continue;
        let result = placeCalls(content, slots, 0);
        if (result.intrusion > 0) result = placeCalls(content, slots, Math.ceil(result.intrusion));
        content.style.paddingBlockEnd = `${Math.max(0, Math.ceil(result.overflow) + CALL_GAP)}px`;
      }
      // 行送りが変わるので、選んだ範囲の塗りも測り直す。
      paintPick();
    };
    let layoutFrame = 0;
    const scheduleLayout = (force = false) => {
      window.cancelAnimationFrame(layoutFrame);
      layoutFrame = window.requestAnimationFrame(() => layoutCalls(force));
    };
    // 本文の幅が変わったら測り直す (画面の回転・幅の変更)。resize イベントより後の、
    // 変わり終わった大きさで呼ばれる。
    new ResizeObserver(() => scheduleLayout()).observe(body);


    /** 凡例。その曲で実際に使われているものだけ (曲ごとに中身が変わる、実物のコール表と同じ)。 */
    const legend = (lines: LyricLine[]): HTMLElement | null => {
      if (!vocabulary) return null;
      const calls = lines.flatMap((l) => l.calls ?? []);
      const usedEmphases = vocabulary.emphases.filter(
        (e) => e.kind !== "normal" && calls.some((c) => c.emphasis === e.kind),
      );
      const usedClaps = vocabulary.claps.filter((k) => lines.some((l) => l.clap === k.kind));
      if (usedEmphases.length === 0 && usedClaps.length === 0) return null;
      const box = el("p", "lyrics__legend");
      for (const e of usedEmphases) {
        const item = el("span", "lyrics__legend-item");
        item.append(el("span", `lyrics__dot lyrics__dot--${e.kind}`), e.label);
        box.append(item);
      }
      for (const k of usedClaps) {
        const item = el("span", "lyrics__legend-item");
        item.append(el("span", "lyrics__legend-symbol", k.symbol), k.label);
        box.append(item);
      }
      return box;
    };

    const render = (lines: LyricLine[], displays: LyricLineDisplay[]): void => {
      const nodes: HTMLElement[] = [];
      lineEls.length = 0;
      lineRuns.length = 0;
      lineLengths.length = 0;
      const head = legend(lines);
      if (head) nodes.push(head);
      // 手拍子の記号は行頭の固定幅の列に置く。ある行だけ本文が右にズレないよう、
      // 1 行でも指示があれば全行にその列を確保する (アプリと同じ)。
      const clapColumn = lines.some((l) => l.clap && vocabulary);
      lines.forEach((line, index) => {
        const calls = line.calls ?? [];
        const display = displays[index] ?? plainDisplay(line);
        const kind = line.kind ?? "lyric";
        const p = el("p", `lyrics__line lyrics__line--${kind}`);
        p.id = `lyric-line-${index + 1}`;
        placingRuns = [];
        if (clapColumn) {
          const clap = vocabulary!.claps.find((k) => k.kind === line.clap);
          const glyph = el("span", "lyrics__clap", clap?.symbol ?? "");
          if (clap) glyph.setAttribute("aria-label", clap.label);
          p.append(glyph);
        }
        const main = el("span", "lyrics__main");
        main.append(lineContent(calls, display));
        const names = partNames(display);
        if (names) main.append(names);
        p.append(main);
        nodes.push(p);
        lineEls.push(p);
        lineRuns.push(placingRuns);
        lineLengths.push(display.runs.at(-1)?.end ?? 0);
      });
      body.replaceChildren(...nodes, marks);
    };

    /** 1 曲ぶんを取りに行って描く。描けたら true (2 度目以降は取りに行かない)。 */
    let loading: Promise<boolean> | null = null;
    const load = (): Promise<boolean> =>
      (loading ??= (async () => {
        button.disabled = true;
        say("読み込み中…");
        try {
          // **1 曲ぶんだけ。** まとめて取る道は用意しない。
          const res = await fetch(source, { headers: { Accept: "application/json" } });
          if (!res.ok) throw new Error(String(res.status));
          const data = (await res.json()) as { lines: LyricLine[] };
          // 字の置き方 (振り仮名・被せ・歌い分け) は wasm。読めなければ素の本文で出す (歌詞は読める)。
          const displays = await lyricLinesDisplay(
            data.lines,
            cast.map((m) => m.id),
          ).catch((e: unknown) => {
            console.error("lyrics: 置き方を組めない", e);
            return data.lines.map(plainDisplay);
          });
          render(data.lines, displays);
          // 位置は見える状態で測る (隠れたままでは矩形が全部 0)。
          body.hidden = false;
          layoutCalls(true);
          // 書体の読み込みで幅が変わることがあるので、揃ってからもう一度。
          void document.fonts?.ready.then(() => scheduleLayout(true));
          button.hidden = true;
          hint.textContent = coarse.matches
            ? "行をタップすると、その行へのリンクを共有できます。長押ししたままなぞると範囲を選べます。"
            : "行をクリック、またはドラッグで範囲を選ぶと、その部分へのリンクを共有できます。";
          hint.hidden = false;
          say("歌詞を表示しました。");
          return true;
        } catch (e) {
          say("歌詞を読み込めませんでした。アプリからご覧ください。");
          button.disabled = false;
          loading = null;
          console.error("lyrics: 取得に失敗", e);
          return false;
        }
      })());

    button.addEventListener("click", async () => {
      if (await load()) body.focus();
    });

    // --- 歌詞の一部へのリンク ------------------------------------------------------
    // 歌詞は写せない (コピー・選択を止めている) ので、代わりに「ここ」を指す URL を渡す。
    // ブラウザの文字選択は使わない (スマホの選択メニューの「共有」「コピー」から本文が出てしまう)。
    // 自前で選ぶ: 行をタップ / クリックでその行、マウスはドラッグ、指は長押ししてなぞる。
    // 位置は元の本文のスカラー位置 (振り仮名の記号を含む、DB の本文の数え方) で持つ。
    // URL は `#lyric-12` (1 行)、`#lyric-12-14` (行ごと)、`#lyric-12.3-14.8` (行内の位置まで)。

    interface Pos {
      /** 行 (0 始まり)。 */
      line: number;
      /** 行内の位置 (元の本文のスカラー単位)。 */
      off: number;
    }
    interface Pick {
      from: Pos;
      to: Pos;
    }
    const cmp = (a: Pos, b: Pos): number => a.line - b.line || a.off - b.off;
    const ordered = (a: Pos, b: Pos): Pick => (cmp(a, b) <= 0 ? { from: a, to: b } : { from: b, to: a });
    const wholeLines = (a: number, b: number): Pick => ({
      from: { line: Math.min(a, b), off: 0 },
      to: { line: Math.max(a, b), off: lineLengths[Math.max(a, b)] ?? 0 },
    });
    const isWholeLines = (p: Pick): boolean => p.from.off === 0 && p.to.off === (lineLengths[p.to.line] ?? 0);

    /** URL の断片。行ごとなら位置を省く (短く、読める)。 */
    const fragmentOf = (p: Pick): string => {
      const a = p.from.line + 1;
      const b = p.to.line + 1;
      if (isWholeLines(p)) return a === b ? `lyric-${a}` : `lyric-${a}-${b}`;
      return `lyric-${a}.${p.from.off}-${b}.${p.to.off}`;
    };
    const parseFragment = (hash: string): Pick | null => {
      const m = /^lyric-(\d+)(?:\.(\d+))?(?:-(\d+)(?:\.(\d+))?)?$/.exec(hash);
      if (!m || lineEls.length === 0) return null;
      const last = lineEls.length - 1;
      const clampLine = (n: number) => Math.min(Math.max(n - 1, 0), last);
      const a = clampLine(Number(m[1]));
      const b = m[3] ? clampLine(Number(m[3])) : a;
      const len = (l: number) => lineLengths[l] ?? 0;
      const from = { line: a, off: m[2] ? Math.min(Number(m[2]), len(a)) : 0 };
      const to = { line: b, off: m[4] ? Math.min(Number(m[4]), len(b)) : len(b) };
      return ordered(from, to);
    };
    const urlOf = (p: Pick): string => `${location.origin}${location.pathname}#${fragmentOf(p)}`;
    const linesLabel = (p: Pick): string =>
      p.from.line === p.to.line ? `${p.from.line + 1}行目` : `${p.from.line + 1}〜${p.to.line + 1}行目`;

    /** スカラー位置 → その字のひと続きの文字ノードの UTF-16 位置。 */
    const utf16 = (text: string, k: number): number => Array.from(text).slice(0, k).join("").length;

    /** 1 行の [s, e) を、字のひと続きごとの DOM の範囲にする (振り仮名つきの字は丸ごと)。 */
    const rangesOf = (line: number, s: number, e: number): Range[] => {
      const out: Range[] = [];
      for (const run of lineRuns[line] ?? []) {
        const lo = Math.max(s, run.start);
        const hi = Math.min(e, run.end);
        if (hi <= lo) continue;
        const r = document.createRange();
        const text = run.node.data;
        if (run.exact) {
          r.setStart(run.node, utf16(text, lo - run.start));
          r.setEnd(run.node, utf16(text, hi - run.start));
        } else {
          r.selectNodeContents(run.node);
        }
        out.push(r);
      }
      return out;
    };

    /** 選んだ範囲を塗る。字の下に、表示行ごとに 1 枚の平らな面 (重ね塗りの濃淡を出さない)。 */
    let pick: Pick | null = null;
    const paintPick = (): void => {
      if (!pick || body.hidden) {
        marks.replaceChildren();
        return;
      }
      const origin = marks.getBoundingClientRect();
      const rows: { left: number; right: number; top: number; bottom: number }[] = [];
      for (let line = pick.from.line; line <= pick.to.line; line++) {
        const s = line === pick.from.line ? pick.from.off : 0;
        const e = line === pick.to.line ? pick.to.off : (lineLengths[line] ?? 0);
        for (const range of rangesOf(line, s, e)) {
          for (const r of range.getClientRects()) {
            if (r.width === 0) continue;
            const row = rows.find((b) => Math.min(b.bottom, r.bottom) - Math.max(b.top, r.top) > Math.min(r.height, b.bottom - b.top) / 2);
            if (row) {
              row.left = Math.min(row.left, r.left);
              row.right = Math.max(row.right, r.right);
              row.top = Math.min(row.top, r.top);
              row.bottom = Math.max(row.bottom, r.bottom);
            } else rows.push({ left: r.left, right: r.right, top: r.top, bottom: r.bottom });
          }
        }
      }
      marks.replaceChildren(
        ...rows.map((b) => {
          const m = el("span", "lyrics__mark");
          m.style.translate = `${b.left - origin.left - 2}px ${b.top - origin.top}px`;
          m.style.inlineSize = `${b.right - b.left + 4}px`;
          m.style.blockSize = `${b.bottom - b.top}px`;
          return m;
        }),
      );
      for (const [i, p] of lineEls.entries()) {
        if (i >= pick.from.line && i <= pick.to.line) p.dataset.picked = "";
        else delete p.dataset.picked;
      }
    };

    /** 指 / ポインタの位置 → 行と行内の位置。字の矩形を測って、近いほうの字の境目を返す。 */
    const hitTest = (x: number, y: number): Pos | null => {
      if (lineEls.length === 0) return null;
      let line = -1;
      let best = Infinity;
      for (const [i, p] of lineEls.entries()) {
        const r = p.getBoundingClientRect();
        if (y >= r.top && y <= r.bottom) {
          line = i;
          break;
        }
        const d = y < r.top ? r.top - y : y - r.bottom;
        if (d < best) {
          best = d;
          line = i;
        }
      }
      const cells: { start: number; end: number; rect: DOMRect }[] = [];
      for (const run of lineRuns[line] ?? []) {
        if (run.exact) {
          const chars = Array.from(run.node.data);
          let u = 0;
          chars.forEach((c, k) => {
            const r = document.createRange();
            r.setStart(run.node, u);
            r.setEnd(run.node, (u += c.length));
            const rect = r.getClientRects()[0];
            if (rect) cells.push({ start: run.start + k, end: run.start + k + 1, rect });
          });
        } else {
          const r = document.createRange();
          r.selectNodeContents(run.node);
          const rect = r.getBoundingClientRect();
          if (rect.width > 0) cells.push({ start: run.start, end: run.end, rect });
        }
      }
      if (cells.length === 0) return { line, off: 0 };
      // y に一番近い表示行の字だけを見る。
      const dy = (r: DOMRect) => (y < r.top ? r.top - y : y > r.bottom ? y - r.bottom : 0);
      const nearest = Math.min(...cells.map((c) => dy(c.rect)));
      const row = cells.filter((c) => dy(c.rect) <= nearest + 1);
      const first = row[0]!;
      const last = row[row.length - 1]!;
      if (x <= first.rect.left) return { line, off: first.start };
      if (x >= last.rect.right) return { line, off: last.end };
      const cell = row.find((c) => x >= c.rect.left && x <= c.rect.right) ?? last;
      return { line, off: x < (cell.rect.left + cell.rect.right) / 2 ? cell.start : cell.end };
    };

    // 共有の帯。
    const share = root.querySelector<HTMLElement>("[data-lyrics-share]")!;
    const shareLines = share.querySelector<HTMLElement>("[data-lyrics-share-lines]")!;
    const copyButton = share.querySelector<HTMLButtonElement>("[data-lyrics-share-copy]")!;
    const nativeButton = share.querySelector<HTMLButtonElement>("[data-lyrics-share-native]")!;
    const closeButton = share.querySelector<HTMLButtonElement>("[data-lyrics-share-close]")!;
    const canShare = typeof navigator.share === "function" && coarse.matches;
    // 指の端末では OS の共有を主に、コピーは脇に。マウスではコピーが主。
    nativeButton.hidden = !canShare;
    copyButton.classList.toggle("btn--ghost", canShare);

    const COPY_LABEL = copyButton.textContent ?? "";
    let copiedTimer = 0;
    const setPick = (next: Pick | null, opts: { bar: boolean } = { bar: true }): void => {
      pick = next;
      paintPick();
      if (!next) {
        for (const p of lineEls) delete p.dataset.picked;
        share.hidden = true;
        document.documentElement.classList.remove("has-lyrics-share");
        return;
      }
      shareLines.textContent = linesLabel(next);
      window.clearTimeout(copiedTimer);
      copyButton.textContent = COPY_LABEL;
      share.hidden = !opts.bar;
      document.documentElement.classList.toggle("has-lyrics-share", opts.bar);
    };

    const copyLink = async (): Promise<boolean> => {
      if (!pick) return false;
      try {
        await navigator.clipboard.writeText(urlOf(pick));
        return true;
      } catch {
        return false;
      }
    };
    copyButton.addEventListener("click", async () => {
      const ok = await copyLink();
      copyButton.textContent = ok ? "コピーしました" : "コピーできませんでした";
      say(ok ? "この部分へのリンクをコピーしました。" : "リンクをコピーできませんでした。");
      window.clearTimeout(copiedTimer);
      copiedTimer = window.setTimeout(() => (copyButton.textContent = COPY_LABEL), 2000);
    });
    nativeButton.addEventListener("click", () => {
      if (!pick) return;
      // 本文は渡さない (写しを外へ出さない)。渡すのは場所だけ。
      navigator.share({ title: document.title, url: urlOf(pick) }).catch(() => {});
    });
    closeButton.addEventListener("click", () => setPick(null));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && pick) setPick(null);
    });
    // ⌘C / Ctrl+C は本文の代わりに、選んだ所へのリンクを写す。
    document.addEventListener("copy", (e) => {
      if (!pick || share.hidden || !(window.getSelection()?.isCollapsed ?? true)) return;
      e.preventDefault();
      e.clipboardData?.setData("text/plain", urlOf(pick));
      say("歌詞は写せないため、この部分へのリンクをコピーしました。");
      copyButton.textContent = "コピーしました";
      window.clearTimeout(copiedTimer);
      copiedTimer = window.setTimeout(() => (copyButton.textContent = COPY_LABEL), 2000);
    });

    // 選び方。
    const LONG_PRESS_MS = 400;
    const SLOP = 10; // これより動いたらスクロール (タップ / 長押しではない)
    const EDGE = 56; // なぞっている指が画面の端に近づいたら送る
    interface Gesture {
      id: number;
      touch: boolean;
      x0: number;
      y0: number;
      x: number;
      y: number;
      press: Pos;
      /** なぞり中 (マウスは押して動かしたら、指は長押しが成立したら)。 */
      dragging: boolean;
      moved: boolean;
      timer: number;
      shift: boolean;
    }
    let g: Gesture | null = null;
    let edgeFrame = 0;

    const dragTo = (x: number, y: number) => {
      if (!g) return;
      const at = hitTest(x, y);
      if (!at) return;
      // 指の長押しは押した行を丸ごと選んだ状態から始まる。同じ行の中でなぞれば字単位。
      if (g.touch && at.line === g.press.line && at.off === g.press.off) {
        setPick(wholeLines(at.line, at.line), { bar: false });
      } else {
        setPick(ordered(g.press, at), { bar: false });
      }
    };
    const edgeScroll = () => {
      if (!g?.dragging) return;
      const dy = g.y < EDGE ? -10 : g.y > innerHeight - EDGE ? 10 : 0;
      if (dy !== 0) {
        window.scrollBy(0, dy);
        dragTo(g.x, g.y);
      }
      edgeFrame = requestAnimationFrame(edgeScroll);
    };
    const startDrag = () => {
      if (!g) return;
      g.dragging = true;
      if (g.touch) {
        navigator.vibrate?.(10);
        setPick(wholeLines(g.press.line, g.press.line), { bar: false });
      }
      cancelAnimationFrame(edgeFrame);
      edgeFrame = requestAnimationFrame(edgeScroll);
    };
    const endGesture = () => {
      if (g) window.clearTimeout(g.timer);
      cancelAnimationFrame(edgeFrame);
      g = null;
    };

    body.addEventListener("pointerdown", (e) => {
      if (e.button !== 0 || lineEls.length === 0) return;
      const press = hitTest(e.clientX, e.clientY);
      if (!press) return;
      const touch = e.pointerType !== "mouse";
      g = { id: e.pointerId, touch, x0: e.clientX, y0: e.clientY, x: e.clientX, y: e.clientY, press, dragging: false, moved: false, timer: 0, shift: e.shiftKey };
      if (touch) g.timer = window.setTimeout(startDrag, LONG_PRESS_MS);
      else body.setPointerCapture(e.pointerId);
    });
    body.addEventListener("pointermove", (e) => {
      if (!g || e.pointerId !== g.id) return;
      g.x = e.clientX;
      g.y = e.clientY;
      const far = Math.hypot(e.clientX - g.x0, e.clientY - g.y0) > SLOP;
      if (!g.dragging) {
        if (!far) return;
        // 指: 長押しの前に動いたらスクロール。マウス: 押して動かしたらなぞり。
        if (g.touch) return endGesture();
        startDrag();
      }
      g.moved ||= far;
      dragTo(e.clientX, e.clientY);
    });
    // なぞっている間はページを動かさない (長押しが成立する前は普通にスクロールする)。
    body.addEventListener(
      "touchmove",
      (e) => {
        if (g?.dragging) e.preventDefault();
      },
      { passive: false },
    );
    body.addEventListener("contextmenu", (e) => {
      if (g?.touch) e.preventDefault();
    });
    body.addEventListener("pointerup", (e) => {
      if (!g || e.pointerId !== g.id) return;
      const done = g;
      endGesture();
      if (done.dragging) {
        if (pick) setPick(pick);
        return;
      }
      // タップ / クリック: その行。選んでいる 1 行をもう一度押したら外す。Shift+クリックは広げる。
      const line = done.press.line;
      if (done.shift && pick) {
        const down = line >= pick.from.line;
        setPick(ordered(down ? pick.from : pick.to, { line, off: down ? (lineLengths[line] ?? 0) : 0 }));
        return;
      }
      const same = pick && pick.from.line === line && pick.to.line === line && isWholeLines(pick) && !share.hidden;
      setPick(same ? null : wholeLines(line, line));
    });
    body.addEventListener("pointercancel", () => endGesture());
    // 歌詞と帯の外を押したら選択を外す。
    document.addEventListener("pointerdown", (e) => {
      const t = e.target as Node | null;
      if (!pick || !t || body.contains(t) || share.contains(t)) return;
      setPick(null);
    });

    // --- 共有された URL で来たとき -------------------------------------------------
    // 歌詞のタブを開き、1 曲ぶんを読み込み、その場所を塗ってそこまで送る。
    const openLyricsTab = () => {
      const panel = root.closest<HTMLElement>(".tabpanel");
      const key = panel?.id.replace(/^tab-/, "");
      const input = key
        ? root.closest(".tabset")?.querySelector<HTMLInputElement>(`:scope > .tabset__input[value="${CSS.escape(key)}"]`)
        : null;
      if (input && !input.checked) input.checked = true;
    };
    const arrive = async () => {
      const hash = decodeURIComponent(location.hash.slice(1));
      if (!/^lyric-\d/.test(hash)) return;
      openLyricsTab();
      if (!(await load())) return;
      const target = parseFragment(hash);
      if (!target) return;
      // 書体が揃って行送りが決まってから測る。
      await document.fonts?.ready;
      layoutCalls(true);
      setPick(target, { bar: false });
      lineEls[target.from.line]?.scrollIntoView({ block: "center" });
      say(`共有された歌詞の位置 (${linesLabel(target)}) を表示しています。`);
    };
    void arrive();
    addEventListener("hashchange", () => void arrive());
  }
</script>
