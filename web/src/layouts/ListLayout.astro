---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SegmentedLinks from "../components/SegmentedLinks.astro";
import type { NavLink } from "../lib/schema/NavLink";
import type { SeoBlock } from "../lib/schema/SeoBlock";
import type { SiteMeta } from "../lib/schema/SiteMeta";
import Count from "../components/Count.astro";

/**
 * 一覧ページの枠。
 * 切替 (今後/開催済み・ブランド・年・都道府県) は **クライアント状態ではなくリンク**。
 * どれが現在地かは Rust が `current` で出す。
 */
interface Props {
  seo: SeoBlock;
  meta: SiteMeta;
  title: string;
  total?: number | null;
  themeKey?: string;
  scopeLinks?: readonly NavLink[];
  scopeLabel?: string;
  filterLinks?: readonly NavLink[];
  filterLabel?: string;
  wide?: boolean;
}
const {
  seo,
  meta,
  title,
  total,
  themeKey,
  scopeLinks = [],
  scopeLabel = "表示の切替",
  filterLinks = [],
  filterLabel = "絞り込み",
  wide = false,
} = Astro.props;
---

<BaseLayout seo={seo} meta={meta} themeKey={themeKey} wide={wide}>
  <div class="u-stack">
    <Breadcrumbs crumbs={seo.breadcrumbs} />
    <h1 class="hero__title">{title}</h1>
    {
      total !== undefined && total !== null && (
        <p class="u-dim">
          <Count value={total} /> 件
        </p>
      )
    }
    <SegmentedLinks label={scopeLabel} links={scopeLinks} />
    <SegmentedLinks label={filterLabel} links={filterLinks} variant="chips" />
  </div>
  <slot />
</BaseLayout>
