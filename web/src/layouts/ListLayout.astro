---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SegmentedLinks from "../components/SegmentedLinks.astro";
import type { NavLink } from "../lib/schema/NavLink";
import type { SeoBlock } from "../lib/schema/SeoBlock";
import Count from "../components/Count.astro";

/**
 * 一覧ページの枠。
 * 切替 (今後/開催済み・ブランド・年・都道府県) は **クライアント状態ではなくリンク**。
 * どれが現在地かは Rust が `current` で出す。
 */
interface Props {
  seo: SeoBlock;
  title: string;
  total?: number | null;
  themeKey?: string;
  scopeLinks?: readonly NavLink[];
  scopeLabel?: string;
  filterLinks?: readonly NavLink[];
  filterLabel?: string;
  wide?: boolean;
}
const {
  seo,
  title,
  total,
  themeKey,
  scopeLinks = [],
  scopeLabel = "表示の切替",
  filterLinks = [],
  filterLabel = "絞り込み",
  wide = false,
} = Astro.props;
const hasFilters = scopeLinks.length > 0 || filterLinks.length > 0;
---

<BaseLayout seo={seo} themeKey={themeKey} wide={wide}>
  <div class="list-head">
    <Breadcrumbs crumbs={seo.breadcrumbs} />
    <div class="list-head__title">
      <h1>{title}</h1>
      {
        total !== undefined && total !== null && (
          <span class="list-head__count">
            <Count value={total} /> 件
          </span>
        )
      }
    </div>
    {
      hasFilters && (
        <div class="list-head__filters">
          <SegmentedLinks label={scopeLabel} links={scopeLinks} />
          <SegmentedLinks label={filterLabel} links={filterLinks} variant="chips" />
        </div>
      )
    }
    {/* 見出しの直下に添える説明 (本文と同じ間隔で離すと 1 行ごとに節に見える)。 */}
    <slot name="lede" />
  </div>
  <slot />
</BaseLayout>
