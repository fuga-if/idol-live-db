---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SegmentedLinks from "../components/SegmentedLinks.astro";
import FilterMenu from "../components/FilterMenu.astro";
import type { FilterAxis } from "../lib/schema/FilterAxis";
import type { SeoBlock } from "../lib/schema/SeoBlock";
import Count from "../components/Count.astro";

/**
 * 一覧ページの枠。
 * 切替 (今後/開催済み・ブランド・年・都道府県) は **クライアント状態ではなくリンク**。
 * どの軸をどの名で出すか、どれが現在地かは Rust (`FilterAxis` / `NavLink.current`)。
 * 2〜3 択の切替 (`scope`) は帯、値の多い軸 (`filters`) は畳んだメニューにして、頭に札を並べない。
 */
interface Props {
  seo: SeoBlock;
  title: string;
  total?: number | null;
  themeKey?: string;
  scope?: FilterAxis;
  filters?: readonly FilterAxis[];
  wide?: boolean;
}
const { seo, title, total, themeKey, scope, filters = [], wide = false } = Astro.props;
const hasFilters = scope !== undefined || filters.length > 0;
---

<BaseLayout seo={seo} themeKey={themeKey} wide={wide}>
  <div class="list-head">
    <Breadcrumbs crumbs={seo.breadcrumbs} />
    <div class="list-head__title">
      <h1>{title}</h1>
      {
        total !== undefined && total !== null && (
          <span class="list-head__count">
            <Count value={total} /> 件
          </span>
        )
      }
    </div>
    {
      hasFilters && (
        <div class="list-head__filters fmenu-row">
          {scope && <SegmentedLinks axis={scope} />}
          {filters.map((f) => (
            <FilterMenu axis={f} group="list-filters" />
          ))}
        </div>
      )
    }
    {/* 見出しの直下に添える説明 (本文と同じ間隔で離すと 1 行ごとに節に見える)。 */}
    <slot name="lede" />
  </div>
  <slot />
</BaseLayout>
