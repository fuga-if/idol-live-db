---
import ListLayout from "../../layouts/ListLayout.astro";
import ListContainer from "../../components/ListContainer.astro";
import RankingRow from "../../components/RankingRow.astro";
import CommunityTagChip from "../../components/CommunityTagChip.astro";
import NavLinkLine from "../../components/NavLinkLine.astro";
import { page, pathsFor } from "../../lib/data";
import type { TagPage } from "../../lib/schema/TagPage";

/** タグ 1 つの曲一覧。付けた人の多い順 (順位と人数は Rust が振る。空のタグに一覧は無い)。 */
export const getStaticPaths = () => pathsFor("tag", "tagId");

const tag = page<TagPage>(Astro.props.data);
---

<ListLayout seo={tag.seo} title={tag.title} total={tag.total}>
  <p slot="lede" class="lede lede--small u-row">
    <CommunityTagChip tag={tag.badge} />
    {tag.description}
  </p>
  <p slot="lede" class="u-muted">{tag.lede}</p>

  <ListContainer as="ol">
    {
      tag.items.map((row) => (
        <li>
          <RankingRow
            rank={row.rank}
            artwork
            artworkUrl={row.ref.artworkUrl}
            title={row.ref.name}
            sub={row.subtitle}
            metric={row.votes}
            unit="人"
            href={row.ref.path}
            themeKey={row.ref.themeKey}
          />
        </li>
      ))
    }
  </ListContainer>

  <NavLinkLine link={tag.allTagsLink} />
</ListLayout>
