---
import ListLayout from "../../layouts/ListLayout.astro";
import ListContainer from "../../components/ListContainer.astro";
import ListRow from "../../components/ListRow.astro";
import CommunityTagChip from "../../components/CommunityTagChip.astro";
import { optionalPage, page } from "../../lib/data";
import type { TagListPage } from "../../lib/schema/TagListPage";

/**
 * 曲に付いたタグの一覧。
 *
 * **読むだけ。** タグ付けはログインが要るので、この出面には操作を置かない。
 * 並び (曲の多い順)・文言・どのタグに一覧があるかは Rust が決めている。
 */
export const getStaticPaths = () => optionalPage("tagListIndex", "/tags/");

const list = page<TagListPage>(Astro.props.data);
---

<ListLayout seo={list.seo} title={list.title} total={list.total}>
  <p slot="lede" class="u-muted">{list.lede}</p>

  <ListContainer as="ul" rows>
    {
      list.items.map((item) => (
        <li>
          <ListRow href={item.path} meta={[item.description]}>
            <span slot="title" class="u-row">
              <CommunityTagChip tag={item.badge} />
              {item.officialLabel && <span class="badge">{item.officialLabel}</span>}
            </span>
            <span slot="trailing" class="list-row__metric">
              <span class="num num--medium">{item.songCount.toLocaleString("ja-JP")}</span>
              <span class="num__unit">曲</span>
            </span>
          </ListRow>
        </li>
      ))
    }
  </ListContainer>
</ListLayout>
