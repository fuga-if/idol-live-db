---
import ListLayout from "../../layouts/ListLayout.astro";
import ListContainer from "../../components/ListContainer.astro";
import DatedRow from "../../components/DatedRow.astro";
import Count from "../../components/Count.astro";
import TagChip from "../../components/TagChip.astro";
import CommunityTagChip from "../../components/CommunityTagChip.astro";
import { page, routeData } from "../../lib/data";
import type { TagListPage } from "../../lib/schema/TagListPage";

/**
 * 曲に付いたタグの一覧。
 *
 * **読むだけ。** タグ付けはログインが要るので、この出面には操作を置かない。
 * 並び (曲の多い順)・文言・どのタグに一覧があるかは Rust が決めている。
 */
const list = page<TagListPage>(routeData("tagListIndex", "/tags/"));
---

<ListLayout seo={list.seo} title={list.title} total={list.total}>
  <p slot="lede" class="u-muted">{list.lede}</p>

  <ListContainer as="ul">
    {
      list.items.map((item) => (
        <li>
          <DatedRow href={item.path} meta={[item.description]}>
            <span slot="title" class="u-row">
              <CommunityTagChip tag={item.badge} />
              {item.officialLabel && <TagChip text={item.officialLabel} kind="all" />}
            </span>
            <Count slot="trailing" strong value={item.songCount} unit="曲" />
          </DatedRow>
        </li>
      ))
    }
  </ListContainer>
</ListLayout>
