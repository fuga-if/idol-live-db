---
import DetailLayout from "../../layouts/DetailLayout.astro";
import Section from "../../components/Section.astro";
import PerformerNamePref from "../../components/PerformerNamePref.astro";
import SetlistDisplayPref from "../../components/SetlistDisplayPref.astro";
import SetlistRow from "../../components/SetlistRow.astro";
import RefList from "../../components/RefList.astro";
import DetailHead from "../../components/DetailHead.astro";
import Facts from "../../components/Facts.astro";
import StatStrip from "../../components/StatStrip.astro";
import Count from "../../components/Count.astro";
import EmptyState from "../../components/EmptyState.astro";
import Pager from "../../components/Pager.astro";
import ForecastList from "../../components/ForecastList.astro";
import { page, pathsFor } from "../../lib/data";
import type { ShowPage } from "../../lib/schema/ShowPage";

export const getStaticPaths = () => pathsFor("show", "showId");

const show = page<ShowPage>(Astro.props.data);

// 同じライブの公演の切替。帯 (数本) か前後への送り (ツアーのように多いとき) か、
// 単日公演で無しかは Rust が本数で決めている (`siblingNav`)。送りのときは全部の並びを脇に置く。
const siblings = show.siblingShows;
const siblingsAsSegments = show.siblingNav === "segments";
const siblingsAsPager = show.siblingNav === "pager";
// 自分は必ず並びの中にいる (Rust が自分も含めて返す)。
const position = siblings.findIndex((s) => s.id === show.id);
const prev = siblings[position - 1] ?? null;
const next = siblings[position + 1] ?? null;
const setlistCount = show.setlistSections.reduce((n, section) => n + section.rows.length, 0);
---

<DetailLayout
  seo={show.seo}
  themeKey={show.themeKey}
  app={show.app}
  isCharacterLive={show.isCharacterLive}
  asideAfterMain
>
  <Fragment slot="hero">
    <DetailHead
      imprint={["SETLIST", siblingsAsSegments ? null : show.showLabel]}
      date={show.dateBadge}
      title={show.heading}
      titleHref={show.event.path}
      id="show-title"
    >
      {/* 見出しの本体はライブ名 (何のライブかが一番大きい情報)。公演の見分け (`Day2`) は
          頭の印字が言う (公演の切替タブがあるときはタブが言うので出さない)。 */}
      <Fragment slot="sub">
        <p class="dhead__date">{show.dateBadge.spoken}</p>
        <Facts rows={show.factRows} variant="inline" />
      </Fragment>
      <Fragment slot="badges">
        {show.isUpcoming && <span class="badge badge--positive">開催予定</span>}
        {
          show.brand && (
            <a class="badge badge--themed" data-theme={show.brand.themeKey} href={show.brand.path}>
              {show.brand.name}
            </a>
          )
        }
      </Fragment>
    </DetailHead>
    {
      siblingsAsPager && (
        <Pager label="このライブの公演" prev={prev?.path} next={next?.path} numeric>
          <Fragment slot="prev">
            {prev?.name}{" "}
            <Count value={prev?.sub} dim />
          </Fragment>
          {position + 1} / {siblings.length} 公演
          <Fragment slot="next">
            {next?.name}{" "}
            <Count value={next?.sub} dim />
          </Fragment>
        </Pager>
      )
    }
    {
      siblingsAsSegments && (
        <nav class="dtabs" aria-label="このライブの公演">
          {siblings.map((s) => (
            <a href={s.path} aria-current={s.id === show.id ? "page" : undefined}>
              <span class="dtabs__name u-clamp2">{s.name}</span>
              {s.sub && <span class="dtabs__sub num">{s.sub}</span>}
            </a>
          ))}
        </nav>
      )
    }
  </Fragment>

  {
    show.statTiles.length > 0 && (
      <div slot="aside">
        <StatStrip items={show.statTiles} label="この公演の数" />
      </div>
    )
  }

  <Section id="show-setlist" title="セットリスト" count={setlistCount}>
    {/* セトリがある公演だけ。空のセトリに詳しさの切替を置いても何も変わらない。 */}
    <div class="setlist-prefs" slot="tools">
      {!show.setlistEmpty && <SetlistDisplayPref />}
      <PerformerNamePref />
    </div>
    {
      show.setlistEmpty ? (
        <EmptyState {...show.setlistEmpty} />
      ) : (
        <div class="card setlist">
          {show.setlistSections.map((section) => (
            <Fragment>
              {section.label && <h3 class="setlist__section">{section.label}</h3>}
              <ol class="setlist__rows" start={section.rows[0]?.number} aria-label={section.label ?? undefined}>
                {section.rows.map((row) => (
                  <SetlistRow row={row} />
                ))}
              </ol>
            </Fragment>
          ))}
        </div>
      )
    }
  </Section>

  {
    show.forecast && (
      <Section id="show-forecast" title={show.forecast.title}>
        <ForecastList forecast={show.forecast} />
      </Section>
    )
  }

  {
    show.cast.length > 0 && (
      <Section slot="aside" id="show-cast" title="出演者" count={show.cast.length}>
        <RefList refs={show.cast} variant="neutral" label="出演者" />
      </Section>
    )
  }

  {
    show.costumes.length > 0 && (
      <Section slot="aside" id="show-costumes" title="衣装" count={show.costumes.length}>
        <ul class="costumes">
          {show.costumes.map((c) => (
            <li class="costume">
              <span class="costume__head">
                <span class="costume__name">{c.name}</span>
                {c.attribution && <span class="badge">{c.attribution}</span>}
              </span>
              <span class="costume__meta u-muted">
                {/* 「どこで着たか」の文は Rust が組んでいる (区切りも言い方も 1 か所)。 */}
                <span>{c.whereLabel}</span>
                {c.description && <span>{c.description}</span>}
                {c.sourceUrl && (
                  <a class="u-underline-hover" href={c.sourceUrl}>
                    出典
                  </a>
                )}
              </span>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    siblingsAsPager && (
      <Section slot="aside" id="show-siblings" title="このライブの公演" count={siblings.length}>
        <RefList refs={siblings} variant="neutral" withSub label="このライブの公演" />
      </Section>
    )
  }
</DetailLayout>
