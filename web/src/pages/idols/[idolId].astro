---
import DetailLayout from "../../layouts/DetailLayout.astro";
import Section from "../../components/Section.astro";
import Chip from "../../components/Chip.astro";
import Monogram from "../../components/Monogram.astro";
import ListContainer from "../../components/ListContainer.astro";
import LabeledRow from "../../components/LabeledRow.astro";
import DatedRow from "../../components/DatedRow.astro";
import Count from "../../components/Count.astro";
import RefList from "../../components/RefList.astro";
import StatStrip from "../../components/StatStrip.astro";
import RankingRow from "../../components/RankingRow.astro";
import EmptyState from "../../components/EmptyState.astro";
import CommunityTags from "../../components/CommunityTags.astro";
import { page, pathsFor } from "../../lib/data";
import type { IdolPage } from "../../lib/schema/IdolPage";

export const getStaticPaths = () => pathsFor("idol", "idolId");

const idol = page<IdolPage>(Astro.props.data);
---

{/* 電話ではプロフィール・ユニット (脇) より持ち曲・出演公演 (本体) を先に。 */}
<DetailLayout seo={idol.seo} themeKey={idol.themeKey} app={idol.app} asideAfterMain>
  <section class="hero" slot="hero" aria-labelledby="idol-title">
    <Monogram label={idol.monogram} size="hero" />
    <div class="hero__body">
      {idol.brand && <p class="hero__eyebrow">{idol.brand.name}</p>}
      <h1 class="hero__title" id="idol-title">{idol.name}</h1>
      {idol.nameKana && <p class="hero__kana">{idol.nameKana}</p>}
      {idol.currentVoiceActor && <p class="lede">CV: {idol.currentVoiceActor}</p>}
      <div class="hero__meta">
        {idol.brands.map((b) => (
          <Chip text={b.name} href={b.path} variant="themed" themeKey={b.themeKey} />
        ))}
      </div>
      {idol.description && <p class="lede">{idol.description}</p>}
      <StatStrip items={idol.statTiles} label="このアイドルの数" />
    </div>
  </section>

  {
    idol.tags.length > 0 && (
      <Section id="idol-tags" title="みんなのタグ">
        <div class="card card__pad">
          <CommunityTags tags={idol.tags} />
        </div>
      </Section>
    )
  }

  {
    idol.profileRows.length > 0 && (
      <Section slot="aside" id="idol-profile" title="プロフィール">
        <ListContainer>
          {idol.profileRows.map((r) => (
            <LabeledRow
              label={r.label}
              value={r.value}
              href={r.link}
              mono={r.style === "monospaced"}
              swatch={r.style === "colorSwatch"}
            />
          ))}
        </ListContainer>
      </Section>
    )
  }

  {
    idol.voiceActorHistory.length > 1 && (
      <Section slot="aside" id="idol-cv" title="CV">
        <ListContainer>
          {idol.voiceActorHistory.map((v) => (
            <LabeledRow label={v.isCurrent ? "現任" : "歴代"} value={v.display} />
          ))}
        </ListContainer>
      </Section>
    )
  }

  {
    idol.units.length > 0 && (
      <Section slot="aside" id="idol-units" title="所属ユニット" count={idol.units.length}>
        <RefList refs={idol.units} label="所属ユニット" />
      </Section>
    )
  }

  <Section id="idol-songs" title="持ち曲" count={idol.songs.length}>
    {
      idol.songs.length === 0 ? (
        <EmptyState title="持ち曲がまだ登録されていません" />
      ) : (
        <ListContainer as="ul">
          {idol.songs.map((s) => (
            <li>
              {/* 披露回数は Rust が副題に畳んでいる (`N 回披露`)。末尾に重ねて出さない。 */}
              <DatedRow
                title={s.song.name}
                href={s.song.path}
                themeKey={s.song.themeKey}
                meta={[s.subtitle]}
              />
            </li>
          ))}
        </ListContainer>
      )
    }
  </Section>

  {
    idol.performedSongs.length > 0 && (
      <Section id="idol-performed" title="ライブで歌った曲" count={idol.performedSongs.length}>
        <ListContainer as="ol">
          {idol.performedSongs.map((s, i) => (
            <li>
              <RankingRow
                rank={i + 1}
                artwork
                title={s.song.name}
                sub={s.subtitle}
                artworkUrl={s.song.artworkUrl}
                metric={s.times}
                href={s.song.path}
                themeKey={s.song.themeKey}
              />
            </li>
          ))}
        </ListContainer>
      </Section>
    )
  }

  {
    idol.shows.length > 0 && (
      <Section id="idol-shows" title="出演公演" count={idol.shows.length}>
        <ListContainer as="ul">
          {idol.shows.map((s) => (
            <li>
              <DatedRow
                badge={s.dateBadge}
                title={s.event.name}
                href={s.show.path}
                themeKey={s.show.themeKey}
                meta={[s.subtitle]}
              >
                {s.songCount > 0 && <Count slot="trailing" strong value={s.songCount} unit="曲" />}
              </DatedRow>
            </li>
          ))}
        </ListContainer>
      </Section>
    )
  }
</DetailLayout>
