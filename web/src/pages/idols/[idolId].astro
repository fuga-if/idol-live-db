---
import DetailLayout from "../../layouts/DetailLayout.astro";
import Section from "../../components/Section.astro";
import DetailHead from "../../components/DetailHead.astro";
import DetailRow from "../../components/DetailRow.astro";
import StubRow from "../../components/StubRow.astro";
import ListContainer from "../../components/ListContainer.astro";
import LabeledRow from "../../components/LabeledRow.astro";
import RefList from "../../components/RefList.astro";
import StatStrip from "../../components/StatStrip.astro";
import EmptyState from "../../components/EmptyState.astro";
import CommunityTags from "../../components/CommunityTags.astro";
import { page, pathsFor } from "../../lib/data";
import type { IdolPage } from "../../lib/schema/IdolPage";

export const getStaticPaths = () => pathsFor("idol", "idolId");

const idol = page<IdolPage>(Astro.props.data);
const songCount = idol.songSections.reduce((n, sec) => n + sec.songs.length, 0);
const multiShelf = idol.songSections.length > 1;
---

{/* 電話ではプロフィール・ユニット (脇) より持ち曲・出演公演 (本体) を先に。 */}
<DetailLayout seo={idol.seo} themeKey={idol.themeKey} app={idol.app} asideAfterMain>
  <Fragment slot="hero">
    <DetailHead title={idol.name} id="idol-title" kana={idol.nameKana}>
      <Fragment slot="sub">
        {idol.currentVoiceActor && <p class="dhead__cv">CV: {idol.currentVoiceActor}</p>}
        {idol.description && <p class="dhead__note">{idol.description}</p>}
      </Fragment>
      <Fragment slot="badges">
        {
          idol.brands.map((b) => (
            <a class="badge badge--themed" data-theme={b.themeKey} href={b.path}>
              {b.name}
            </a>
          ))
        }
      </Fragment>
    </DetailHead>
    <StatStrip items={idol.statTiles} label="このアイドルの数" />
  </Fragment>

  {
    idol.tags.length > 0 && (
      <Section id="idol-tags" title="みんなのタグ">
        <CommunityTags tags={idol.tags} />
      </Section>
    )
  }

  {
    idol.profileRows.length > 0 && (
      <Section slot="aside" id="idol-profile" title="プロフィール">
        <ListContainer>
          {idol.profileRows.map((r) => (
            <LabeledRow
              label={r.label}
              value={r.value}
              href={r.link}
              mono={r.style === "monospaced"}
              swatch={r.style === "colorSwatch"}
            />
          ))}
        </ListContainer>
      </Section>
    )
  }

  {
    idol.voiceActorHistory.length > 0 && (
      <Section slot="aside" id="idol-cv" title="CV">
        <ListContainer>
          {idol.voiceActorHistory.map((v) => (
            <LabeledRow label={v.label} value={v.display} />
          ))}
        </ListContainer>
      </Section>
    )
  }

  {
    idol.units.length > 0 && (
      <Section slot="aside" id="idol-units" title="所属ユニット" count={idol.units.length}>
        <RefList refs={idol.units} variant="neutral" label="所属ユニット" />
      </Section>
    )
  }

  <Section id="idol-songs" title="持ち曲" count={songCount}>
    {
      idol.songsEmpty ? (
        <EmptyState {...idol.songsEmpty} />
      ) : (
        <div class:list={["shelves", multiShelf && "tabset"]}>
          {/* 棚の切替 = ImasTabs。ラジオ + 兄弟セレクタで切り替えるので JS は要らない
              (CSS が無ければ全部の棚が縦に並ぶ)。棚の並びと見出しはアプリの持ち歌と同じ (Rust)。 */}
          {multiShelf && idol.songSections.map((_, i) => (
            <input class="tabset__input" type="radio" name="idol-shelf" id={`shelf-tab-${i}`} checked={i === 0} />
          ))}
          {multiShelf && (
            <div class="dtabs" role="group" aria-label="持ち曲の種類">
              {idol.songSections.map((sec, i) => (
                <label for={`shelf-tab-${i}`}>
                  <span class="dtabs__name">{sec.shortHeading}</span>
                  <span class="dtabs__sub num">{sec.songs.length.toLocaleString("ja-JP")}</span>
                </label>
              ))}
            </div>
          )}
          <div class="tabset__panels">
            {idol.songSections.map((sec) => (
              <section class="shelf" aria-labelledby={sec.anchor}>
                <h3 class:list={["shelf__title", multiShelf && "u-visually-hidden"]} id={sec.anchor}>
                  {sec.heading}
                  <span class="shelf__count num">{sec.songs.length.toLocaleString("ja-JP")}</span>
                </h3>
                <ListContainer as="ul">
                  {sec.songs.map((s) => (
                    <li>
                      {/* 披露回数は Rust が副題に畳んでいる (`N 回披露`)。末尾に重ねて出さない。 */}
                      <DetailRow artwork={s.song} title={s.song.name} sub={s.subtitle} href={s.song.path} themeKey={s.song.themeKey} />
                    </li>
                  ))}
                </ListContainer>
              </section>
            ))}
          </div>
        </div>
      )
    }
  </Section>

  {
    idol.performedSongs.length > 0 && (
      <Section id="idol-performed" title="ライブで歌った曲" count={idol.performedSongs.length}>
        <ListContainer as="ol">
          {idol.performedSongs.map((s, i) => (
            <li>
              <DetailRow
                rank={i + 1}
                artwork={s.song}
                title={s.song.name}
                sub={s.subtitle}
                metric={s.times}
                href={s.song.path}
                themeKey={s.song.themeKey}
              />
            </li>
          ))}
        </ListContainer>
      </Section>
    )
  }

  {
    idol.shows.length > 0 && (
      <Section id="idol-shows" title="出演公演" count={idol.shows.length}>
        <ul class="stub-list">
          {idol.shows.map((s) => (
            <li>
              <StubRow badge={s.dateBadge} title={s.event.name} href={s.show.path} themeKey={s.show.themeKey} meta={[s.subtitle]}>
                {s.songCount > 0 && (
                  <span slot="trailing" class="num num--medium">
                    {s.songCount}
                    <span class="num__unit">曲</span>
                  </span>
                )}
              </StubRow>
            </li>
          ))}
        </ul>
      </Section>
    )
  }
</DetailLayout>
