---
import DetailLayout from "../../layouts/DetailLayout.astro";
import Section from "../../components/Section.astro";
import StatStrip from "../../components/StatStrip.astro";
import ShowRow from "../../components/ShowRow.astro";
import ListContainer from "../../components/ListContainer.astro";
import LabeledRow from "../../components/LabeledRow.astro";
import Chip from "../../components/Chip.astro";
import ColorDot from "../../components/ColorDot.astro";
import EmptyState from "../../components/EmptyState.astro";
import { page, pathsFor } from "../../lib/data";
import type { EventPage } from "../../lib/schema/EventPage";
import TagChip from "../../components/TagChip.astro";

export const getStaticPaths = () => pathsFor("event", "eventId");

const ev = page<EventPage>(Astro.props.data);

const ticketRows = [
  { label: "チケット発売", value: ev.ticket.openDate },
  { label: "申込締切", value: ev.ticket.deadline },
  { label: "抽選発表", value: ev.ticket.lotteryDate },
];
const hasTicket = ticketRows.some((r) => r.value) || ev.ticket.url;
---

<DetailLayout seo={ev.seo} themeKey={ev.themeKey} app={ev.app}>
  <section class="hero" slot="hero" aria-labelledby="event-title">
    <div class="hero__body">
      <p class="hero__eyebrow">{ev.kindLabel}</p>
      <h1 class="hero__title" id="event-title">{ev.name}</h1>
      {ev.nameKana && <p class="hero__kana">{ev.nameKana}</p>}
      {ev.dateDisplay && <p class="hero__date u-num">{ev.dateDisplay}</p>}
      <div class="hero__meta">
        {ev.isUpcoming && <Chip text="開催予定" variant="selected" />}
        {ev.brand && <Chip text={ev.brand.name} href={ev.brand.path} variant="themed" themeKey={ev.brand.themeKey} />}
        {ev.jointBrands.map((b) => (
          <Chip text={b.name} href={b.path} variant="themed" themeKey={b.themeKey} />
        ))}
        {ev.venues.map((v) => (
          <Chip text={v.name} href={v.path} sub={v.sub} />
        ))}
      </div>
      <StatStrip items={ev.statTiles} label="このライブの数" />
    </div>
  </section>

  <Section id="event-shows" title="公演" count={ev.shows.length}>
    {
      ev.shows.length === 0 ? (
        <EmptyState title="公演がまだ登録されていません" />
      ) : (
        <ListContainer as="ul">
          {ev.shows.map((s) => (
            <ShowRow show={s} />
          ))}
        </ListContainer>
      )
    }
  </Section>

  {
    ev.cast && ev.cast.shows.length > 0 && (
      <Section slot="aside" id="event-cast" title="出演者">
        <div class="u-stack">
          {ev.cast.shows.map((cs) => (
            <div class="card card__pad u-stack">
              <h3 class="row__title">
                <a class="u-underline-hover" href={cs.show.path}>{cs.show.name}</a>
              </h3>
              <ul class="performers">
                {cs.performers.map((m) => (
                  <li>
                    <a class="performer" href={m.ref.path} data-theme={m.ref.themeKey}>
                      <ColorDot />
                      {m.ref.name}
                      {m.isLead && <TagChip text="主演" kind="lead" />}
                      {m.isGuest && <TagChip text="ゲスト" kind="guest" />}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </Section>
    )
  }

  {
    ev.releases.length > 0 && (
      <Section slot="aside" id="event-releases" title="映像・音源">
        <ListContainer>
          {ev.releases.map((r) => (
            <LabeledRow
              label={r.kindLabel}
              value={r.releaseDate ? `${r.title} (${r.releaseDate})` : r.title}
              href={r.url}
            />
          ))}
        </ListContainer>
      </Section>
    )
  }

  {
    hasTicket && (
      <Section slot="aside" id="event-ticket" title="チケット">
        <ListContainer>
          {ticketRows.map((r) => (r.value ? <LabeledRow label={r.label} value={r.value} mono /> : null))}
          {ev.ticket.url && <LabeledRow label="公式情報" value="チケット情報" href={ev.ticket.url} />}
        </ListContainer>
      </Section>
    )
  }
</DetailLayout>
