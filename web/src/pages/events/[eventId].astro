---
import DetailLayout from "../../layouts/DetailLayout.astro";
import Section from "../../components/Section.astro";
import StatStrip from "../../components/StatStrip.astro";
import ShowRow from "../../components/ShowRow.astro";
import ListContainer from "../../components/ListContainer.astro";
import LabeledRow from "../../components/LabeledRow.astro";
import Chip from "../../components/Chip.astro";
import BrandMark from "../../components/BrandMark.astro";
import Performer from "../../components/Performer.astro";
import EmptyState from "../../components/EmptyState.astro";
import { page, pathsFor } from "../../lib/data";
import type { EventPage } from "../../lib/schema/EventPage";
import TagChip from "../../components/TagChip.astro";

export const getStaticPaths = () => pathsFor("event", "eventId");

const ev = page<EventPage>(Astro.props.data);
---

<DetailLayout seo={ev.seo} themeKey={ev.themeKey} app={ev.app} asideAfterMain>
  <section class="hero" slot="hero" aria-labelledby="event-title">
    <div class="hero__body">
      {/* 上の行: ブランドの札 → 種別 → 開催予定。公演ページと同じ並び。 */}
      <p class="hero__eyebrow">
        {ev.brand && (
          <a class="u-underline-hover" href={ev.brand.path}>
            <BrandMark brand={ev.brand} />
          </a>
        )}
        <span>{ev.kindLabel}</span>
        {ev.isUpcoming && <Chip text="開催予定" variant="selected" />}
      </p>
      <h1 class="hero__title" id="event-title">{ev.name}</h1>
      {ev.nameKana && <p class="hero__kana">{ev.nameKana}</p>}
      {ev.dateDisplay && <p class="hero__date u-num">{ev.dateDisplay}</p>}
      {
        (ev.jointBrands.length > 0 || ev.venues.length > 0) && (
          <div class="hero__meta">
            {ev.jointBrands.map((b) => (
              <Chip text={b.name} href={b.path} variant="themed" themeKey={b.themeKey} />
            ))}
            {ev.venues.map((v) => (
              <Chip text={v.name} href={v.path} sub={v.sub} />
            ))}
          </div>
        )
      }
      <StatStrip items={ev.statTiles} label="このライブの数" />
    </div>
  </section>

  <Section id="event-shows" title="公演" count={ev.shows.length}>
    {
      ev.showsEmpty ? (
        <EmptyState {...ev.showsEmpty} />
      ) : (
        <ListContainer as="ul">
          {ev.shows.map((s) => (
            <ShowRow show={s} />
          ))}
        </ListContainer>
      )
    }
  </Section>

  {/* 出演者は本体側 (長いのはこちら。脇の 20rem に 36 人 × 2 日を詰めると 8 行に折れる)。 */}
  {
    ev.cast && ev.cast.shows.length > 0 && (
      <Section id="event-cast" title="出演者">
        <div class="u-stack">
          {ev.cast.shows.map((cs) => (
            <div class="card card__pad u-stack">
              <h3 class="row__title">
                <a class="u-underline-hover" href={cs.show.path}>{cs.show.name}</a>
              </h3>
              <ul class="performers">
                {cs.performers.map((m) => (
                  <li class="u-row">
                    <Performer ref={m.ref} />
                    {m.isLead && <TagChip text="主演" kind="lead" />}
                    {m.isGuest && <TagChip text="ゲスト" kind="guest" />}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </Section>
    )
  }

  {
    ev.releases.length > 0 && (
      <Section slot="aside" id="event-releases" title="映像・音源">
        <ListContainer>
          {ev.releases.map((r) => (
            <LabeledRow label={r.kindLabel} value={r.display} href={r.url} />
          ))}
        </ListContainer>
      </Section>
    )
  }

  {
    /* 日程の語 (受付開始 / 申込締切 / 当落発表) と、出すかどうかは Rust が決める。 */
    ev.ticket && (
      <Section slot="aside" id="event-ticket" title="チケット">
        <ListContainer>
          {ev.ticket.dates.map((d) => <LabeledRow label={d.label} value={d.date} mono />)}
          {ev.ticket.url && <LabeledRow label="公式情報" value="チケット情報" href={ev.ticket.url} />}
        </ListContainer>
      </Section>
    )
  }
</DetailLayout>
