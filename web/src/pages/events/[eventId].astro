---
import DetailLayout from "../../layouts/DetailLayout.astro";
import Section from "../../components/Section.astro";
import StatTile from "../../components/StatTile.astro";
import ShowRow from "../../components/ShowRow.astro";
import ListContainer from "../../components/ListContainer.astro";
import LabeledRow from "../../components/LabeledRow.astro";
import Chip from "../../components/Chip.astro";
import Avatar from "../../components/Avatar.astro";
import RefList from "../../components/RefList.astro";
import EmptyState from "../../components/EmptyState.astro";
import { meta, page, pathsFor } from "../../lib/data";
import type { EventPage } from "../../lib/schema/EventPage";

export const getStaticPaths = () => pathsFor("event", "eventId");

const ev = page<EventPage>(Astro.props.data);

// id → Ref の索引。並びも中身も Rust が決めたものをそのまま引くだけの配線。
const idolById = new Map((ev.cast?.brandIdols ?? []).map((r) => [r.id, r]));
const showName = new Map(ev.shows.map((s) => [s.ref.id, s.ref.name]));
const leadIds = new Map((ev.cast?.leadByShow ?? []).map((s) => [s.showId, new Set(s.idolIds)]));
const guestIds = new Map((ev.cast?.guestByShow ?? []).map((s) => [s.showId, new Set(s.idolIds)]));

const ticketRows = [
  { label: "チケット発売", value: ev.ticket.openDate },
  { label: "申込締切", value: ev.ticket.deadline },
  { label: "抽選発表", value: ev.ticket.lotteryDate },
];
const hasTicket = ticketRows.some((r) => r.value) || ev.ticket.url;
---

<DetailLayout seo={ev.seo} meta={meta()} themeKey={ev.themeKey} app={ev.app}>
  <section class="hero" slot="hero" aria-labelledby="event-title">
    <div class="hero__body">
      <p class="hero__eyebrow">{ev.kindLabel}</p>
      <h1 class="hero__title" id="event-title">{ev.name}</h1>
      {ev.nameKana && <p class="hero__kana">{ev.nameKana}</p>}
      <p class="u-muted">
        {ev.firstDate && <time datetime={ev.firstDate}>{ev.firstDate}</time>}
        {ev.lastDate && ev.lastDate !== ev.firstDate && (
          <> 〜 <time datetime={ev.lastDate}>{ev.lastDate}</time></>
        )}
      </p>
      <div class="hero__meta">
        {ev.isUpcoming && <Chip text="開催予定" variant="selected" />}
        {ev.brand && <Chip text={ev.brand.name} href={ev.brand.path} variant="themed" themeKey={ev.brand.themeKey} />}
        {ev.jointBrands.map((b) => (
          <Chip text={b.name} href={b.path} variant="themed" themeKey={b.themeKey} />
        ))}
      </div>
    </div>
  </section>

  <div class="stat-grid">
    <StatTile glyph="▤" value={ev.stats.showCount} label="公演" />
    <StatTile glyph="≡" value={ev.stats.totalSongs} label="のべ曲数" />
    <StatTile glyph="♬" value={ev.stats.uniqueSongs} label="異なり曲数" />
    <StatTile glyph="☺" value={ev.stats.castCount} label="出演者" />
  </div>

  <Section id="event-shows" title="公演" count={ev.shows.length}>
    {
      ev.shows.length === 0 ? (
        <EmptyState title="公演がまだ登録されていません" />
      ) : (
        <ListContainer as="ul">
          {ev.shows.map((s) => (
            <ShowRow show={s} />
          ))}
        </ListContainer>
      )
    }
  </Section>

  {
    ev.cast && ev.cast.presenceByShow.length > 0 && (
      <Section id="event-cast" title="出演者">
        <div class="u-stack">
          {ev.cast.presenceByShow.map((p) => (
            <div class="card card__pad u-stack">
              <h3 class="section__title">
                {showName.get(p.showId) ?? p.showId}
              </h3>
              <ul class="performers">
                {p.idolIds.map((id) => {
                  const idol = idolById.get(id);
                  return idol ? (
                    <li>
                      <a class="performer" href={idol.path} data-theme={idol.themeKey}>
                        <Avatar monogram={idol.monogram} size="sm" />
                        {idol.name}
                        {leadIds.get(p.showId)?.has(id) && <span class="tag tag--lead">主演</span>}
                        {guestIds.get(p.showId)?.has(id) && <span class="tag tag--guest">ゲスト</span>}
                      </a>
                    </li>
                  ) : null;
                })}
              </ul>
            </div>
          ))}
        </div>
      </Section>
    )
  }

  {
    ev.venues.length > 0 && (
      <Section id="event-venues" title="会場">
        <RefList refs={ev.venues} variant="neutral" withSub label="会場" />
      </Section>
    )
  }

  {
    ev.releases.length > 0 && (
      <Section id="event-releases" title="映像・音源">
        <ListContainer>
          {ev.releases.map((r) => (
            <LabeledRow
              label={r.kindLabel}
              value={r.releaseDate ? `${r.title} (${r.releaseDate})` : r.title}
              href={r.url}
            />
          ))}
        </ListContainer>
      </Section>
    )
  }

  {
    hasTicket && (
      <Section id="event-ticket" title="チケット">
        <ListContainer>
          {ticketRows.map((r) => (r.value ? <LabeledRow label={r.label} value={r.value} mono /> : null))}
          {ev.ticket.url && <LabeledRow label="公式情報" value="チケット情報" href={ev.ticket.url} />}
        </ListContainer>
      </Section>
    )
  }
</DetailLayout>
