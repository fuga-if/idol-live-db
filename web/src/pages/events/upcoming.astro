---
import ListLayout from "../../layouts/ListLayout.astro";
import YearGroups from "../../components/YearGroups.astro";
import { meta, page, routeData } from "../../lib/data";
import type { EventListPage } from "../../lib/schema/EventListPage";

const list = page<EventListPage>(routeData("eventListUpcoming", "/events/upcoming/"));
---

<ListLayout
  seo={list.seo}
  meta={meta()}
  title={list.title}
  total={list.total}
  scopeLinks={list.scopeLinks}
  scopeLabel="今後 / 開催済み"
  filterLinks={list.brandLinks}
  filterLabel="ブランドで絞る"
>
  <YearGroups groups={list.groups} emptyTitle="今後の開催予定はまだ登録されていません" />
</ListLayout>
