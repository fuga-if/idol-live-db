---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import EventRow from "../components/EventRow.astro";
import ShowRow from "../components/ShowRow.astro";
import Ticket from "../components/Ticket.astro";
import Board from "../components/Board.astro";
import EmptyState from "../components/EmptyState.astro";
import SearchBox from "../components/SearchBox.astro";
import { page, routeData } from "../lib/data";
import type { HomePage } from "../lib/schema/HomePage";

/**
 * トップ = ハブの型 (DESIGN_SYSTEM §2.3)。
 * 頭の印字と大見出し → 主役 (次のライブの紙のチケット) → 記録の数 (電光掲示板) →
 * 一覧 (半券の行) → ブランドの判子の格子 → アプリの案内。
 * 何を何件出すか・並びは Rust の `HomePage` のまま。先頭 1 件をチケットにするのは見せ方の判断。
 */
const home = page<HomePage>(routeData("home", "/"));
const [featured, ...restUpcoming] = home.upcoming;
---

<BaseLayout seo={home.seo}>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__body">
      <p class="imprint home-hero__date">IDOL LIVE DB · {home.todayDisplay}</p>
      <h1 class="home-hero__title" id="home-title">
        {home.headline.map((line) => <span>{line}</span>)}
      </h1>
      <p class="lede">{home.tagline}</p>
      <SearchBox />
      {/* 非公式の断りはフッタ (Rust の footerNotes) が全ページで言う。最初の一画面には置かない。 */}
    </div>
    {featured && <Ticket item={featured} countdown={home.nextCountdown} />}
  </section>

  <Board title="STATS" trailing={home.todayDisplay} cells={home.statTiles} label="収録データ" />

  <Section id="home-upcoming" title="これからのライブ" moreHref="/events/upcoming/">
    {
      home.upcomingEmpty ? (
        <EmptyState {...home.upcomingEmpty} />
      ) : (
        restUpcoming.length > 0 && (
          <ul class="stub-list">
            {restUpcoming.map((e) => (
              <EventRow item={e} />
            ))}
          </ul>
        )
      )
    }
  </Section>

  <Section
    id="home-recent"
    title="最近の公演"
    moreHref={home.recentShowsMore.path}
    moreLabel={home.recentShowsMore.label}
  >
    {
      home.recentShowsEmpty ? (
        <EmptyState {...home.recentShowsEmpty} />
      ) : (
        <ul class="stub-list">
          {home.recentShows.map((s) => (
            <ShowRow show={s} />
          ))}
        </ul>
      )
    }
  </Section>

  <Section id="home-brands" title="ブランドから探す" moreHref="/brands/">
    <div class="stamp-grid">
      {
        home.brands.map((b) => (
          <a class="stamp-cell" data-theme={b.ref.themeKey} href={b.ref.path}>
            <span class="stamp" data-len={String(Math.min(b.glyph.length, 5))} aria-hidden="true">
              {b.glyph}
            </span>
            <span class="stamp-cell__name">{b.ref.name}</span>
            <span class="stamp-cell__sub">{b.previewDisplay}</span>
          </a>
        ))
      }
    </div>
  </Section>

  <section class="cta" aria-labelledby="home-app">
    <img
      class="cta__icon"
      src="/logo-mark.png"
      alt=""
      width="64"
      height="64"
      loading="lazy"
      decoding="async"
    />
    <div class="cta__body">
      <h2 class="cta__title" id="home-app">アプリで、もっと</h2>
      <p class="lede lede--small">{home.appNote}</p>
      <p class="cta__actions">
        <a class="btn" href={home.app.appStoreUrl}>App Store で見る</a>
        <a class="btn btn--ghost" href={home.app.repositoryUrl}>GitHub でデータに協力する</a>
      </p>
    </div>
  </section>
</BaseLayout>
