---
import ListLayout from "../../layouts/ListLayout.astro";
import OpenInApp from "../../components/OpenInApp.astro";
import RankingRow from "../../components/RankingRow.astro";
import { optionalPage, page } from "../../lib/data";
import type { PollListPage } from "../../lib/schema/PollListPage";

/**
 * みんなのお題。
 *
 * **読むだけ。** 投票にはログインが要るので、この出面には操作を置かない。
 * 中身は D1 の集計を焼き込んだもので、閲覧のたびに D1 は読まない。
 * 「締切前か」も Rust が `ends_at` と出面の「今日」から決め、添える語 (`endsLabel`) まで出す。
 *
 * 共有 URL (`/polls/#poll-<id>`) はアプリが入っていればアプリで開く (iOS Universal Links /
 * Android App Links)。ここに来たのはアプリが無い人か、アプリ内ブラウザでリンクが発火しなかった人。
 * 節ごとの「アプリで投票する」はアプリのスキーム (`imaslivedb://polls/<id>`) へ飛ばす
 * (同じサイト内の https リンクではアプリが開かない)。アプリが無い人には下の導線がストアを出す。
 * 立てたばかりで一覧にまだ無いお題は、`poll-missing.ts` が知らせを出す。
 */
export const getStaticPaths = () => optionalPage("pollList", "/polls/");

const list = page<PollListPage>(Astro.props.data);
---

<ListLayout seo={list.seo} title={list.title} total={list.total}>
  <p slot="lede" class="u-muted">
    {list.lede}
  </p>

  <p
    class="poll-missing"
    data-poll-missing
    data-app-url-prefix={list.missingPollAppUrlPrefix}
    hidden
  >
    <span>{list.missingPollNote}</span>
    <a class="entry-link" data-poll-missing-link href={list.missingPollAppUrlPrefix}>
      <span class="u-underline-hover">{list.missingPollAppLabel}</span>
      <span class="chevron" aria-hidden="true">›</span>
    </a>
  </p>

  {
    list.polls.map((poll) => (
      <section class="poll" aria-labelledby={`poll-${poll.id}`}>
        {/* ImasFeatureCard の形: 目印 (灰・12px 太字) と右上の数、題、添える日付。 */}
        <div class="poll__head">
          <div class="poll__top">
            <span class="poll__mark">{poll.targetLabel}</span>
            <span class="poll__votes">
              <b class="num num--large">{poll.totalVotes.toLocaleString("ja-JP")}</b>
              <span class="num__unit">票</span>
            </span>
          </div>
          <h2 class="poll__title" id={`poll-${poll.id}`}>{poll.title}</h2>
          {poll.endsOn && (
            <p class="poll__sub">
              {poll.endsLabel} <time datetime={poll.endsOn}>{poll.endsDisplay}</time>
            </p>
          )}
          {poll.description && <p class="lede lede--small">{poll.description}</p>}
        </div>
        <ol class="poll__entries">
          {poll.entries.map((entry) => (
            <li>
              <RankingRow
                rank={entry.rank}
                artwork={entry.ref.kind === "song"}
                artworkUrl={entry.ref.artworkUrl}
                title={entry.ref.name}
                sub={entry.ref.sub}
                metric={entry.votes}
                unit="票"
                href={entry.ref.path}
                themeKey={entry.ref.themeKey}
              />
            </li>
          ))}
        </ol>
        <a class="entry-link poll__app" href={poll.appUrl}>
          <span class="u-underline-hover">{poll.appLabel}</span>
          <span class="chevron" aria-hidden="true">›</span>
        </a>
      </section>
    ))
  }

  <OpenInApp app={list.app} />
</ListLayout>

<script>
  import { watchMissingPoll } from "../../lib/poll-missing";
  watchMissingPoll();
</script>
