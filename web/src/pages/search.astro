---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBox from "../components/SearchBox.astro";
import { meta } from "../lib/data";
import type { SeoBlock } from "../lib/schema/SeoBlock";

/**
 * 検索 — 横断検索の島が動くページ。
 *
 * ページを探すためのナビゲーション補助であって、状態を持つ機能ではない:
 * 島はフォームの送信を止め、履歴も書かず、結果に色も付けない。
 * JS が無効なら素の GET フォームとして送信され (`?q=`)、下の一覧リンクだけが見える。
 */
// 検索は 1 枚きりの静的ページなので、SeoBlock は Rust から来ない。ここで組む。
const seo: SeoBlock = {
  title: "検索 | アイドルライブDB",
  description:
    "アイマスの楽曲・アイドル・ライブ・会場をまとめて検索します。ひらがな / カタカナ / 英字の違いは自動で吸収します。",
  canonical: "/search/",
  ogImage: "/og/default.png",
  robots: "index,follow",
  jsonLd: {},
  breadcrumbs: [
    { name: "ホーム", path: "/" },
    { name: "検索", path: "/search/" },
  ],
};
const site = meta();
---

<BaseLayout seo={seo}>
  <div class="list-head">
    <div class="list-head__title">
      <h1>検索</h1>
    </div>
    <p class="u-muted">
      楽曲・アイドル・ライブ・会場をまとめて探します。ひらがな / カタカナ /
      英字の大小の違いはアプリと同じ規則で吸収します。
    </p>
    <SearchBox island placeholder="例: 未来 / HARUKA / 武道館" />
  </div>

  <div class="search-panel">
    <p class="search-status" id="search-status" data-search-status aria-live="polite">
      検索の準備をしています…
    </p>
    <div
      class="search-results"
      id="search-results"
      role="region"
      aria-label="検索結果"
      data-search-results
    >
    </div>
  </div>

  <div class="empty" data-search-fallback>
    <p class="empty__title">JavaScript を有効にすると、その場で結果が出ます</p>
    <p class="empty__body">
      無効のままでも、下の一覧からすべてのページに辿り着けます。
    </p>
  </div>

  <nav class="link-chips" aria-label="一覧から辿る">
    {site.primaryNav.map((l) => <a href={l.path}>{l.label}の一覧</a>)}
  </nav>
</BaseLayout>

<script>
  import "../lib/search/island";
</script>
