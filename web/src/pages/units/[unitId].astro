---
import DetailLayout from "../../layouts/DetailLayout.astro";
import Section from "../../components/Section.astro";
import DetailHead from "../../components/DetailHead.astro";
import IdolTile from "../../components/IdolTile.astro";
import RefList from "../../components/RefList.astro";
import EmptyState from "../../components/EmptyState.astro";
import { page, pathsFor } from "../../lib/data";
import type { UnitPage } from "../../lib/schema/UnitPage";
import CommunityTags from "../../components/CommunityTags.astro";

export const getStaticPaths = () => pathsFor("unit", "unitId");

const unit = page<UnitPage>(Astro.props.data);
---

<DetailLayout seo={unit.seo} themeKey={unit.themeKey} app={unit.app}>
  <DetailHead slot="hero" imprint={["UNIT"]} title={unit.name} id="unit-title" kana={unit.nameKana}>
    <Fragment slot="sub">
      {unit.nameAlt && <p class="dhead__cv">別名: {unit.nameAlt}</p>}
    </Fragment>
    <Fragment slot="badges">
      <span class="badge">{unit.kindLabel}</span>
      {
        unit.brand && (
          <a class="badge badge--themed" data-theme={unit.brand.themeKey} href={unit.brand.path}>
            {unit.brand.name}
          </a>
        )
      }
    </Fragment>
  </DetailHead>

  {
    unit.tags.length > 0 && (
      <Section id="unit-tags" title="みんなのタグ">
        <CommunityTags tags={unit.tags} />
      </Section>
    )
  }

  {/* メンバーはタイルで幅が要るので脇に寄せず本文に置く (脇の 20rem では 1 列になる)。 */}
  <Section id="unit-members" title="メンバー" count={unit.members.length}>
    {
      unit.membersEmpty ? (
        <EmptyState {...unit.membersEmpty} />
      ) : (
        <ul class="grid-tiles">
          {unit.members.map((m) => (
            <IdolTile entity={m} />
          ))}
        </ul>
      )
    }
  </Section>

  <Section id="unit-songs" title="ユニット曲" count={unit.songs.length}>
    {
      unit.songsEmpty ? (
        <EmptyState {...unit.songsEmpty} />
      ) : (
        <RefList refs={unit.songs} variant="neutral" label="ユニット曲" />
      )
    }
  </Section>
</DetailLayout>
