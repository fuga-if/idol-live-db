---
import DetailLayout from "../../layouts/DetailLayout.astro";
import Section from "../../components/Section.astro";
import Artwork from "../../components/Artwork.astro";
import DetailHead from "../../components/DetailHead.astro";
import DetailRow from "../../components/DetailRow.astro";
import StubRow from "../../components/StubRow.astro";
import CommunityTags from "../../components/CommunityTags.astro";
import SongLyrics from "../../components/SongLyrics.astro";
import RefList from "../../components/RefList.astro";
import ListContainer from "../../components/ListContainer.astro";
import LabeledRow from "../../components/LabeledRow.astro";
import Fold from "../../components/Fold.astro";
import StatStrip from "../../components/StatStrip.astro";
import { setlistAnchorId } from "../../lib/anchors";
import EmptyState from "../../components/EmptyState.astro";
import { page, pathsFor } from "../../lib/data";
import type { SongPage } from "../../lib/schema/SongPage";

export const getStaticPaths = () => pathsFor("song", "songId");

const song = page<SongPage>(Astro.props.data);
---

{/* 電話では脇 (基本情報・クレジット・その他の歌唱者) より本体 (歌詞・披露履歴) を先に。 */}
<DetailLayout seo={song.seo} themeKey={song.themeKey} app={song.app} asideAfterMain>
  <Fragment slot="hero">
    {/* ジャケを左、右に種類・題・歌唱者・配信日 (DESIGN_SYSTEM §2.2)。画像が無ければ色の面 + 曲名。 */}
    <DetailHead imprint={["SONG", song.brand?.name]} title={song.title} id="song-title" kana={song.titleKana}>
      <Artwork slot="lead" title={song.title} artworkUrl={song.artworkUrl} size="hero" />
      <Fragment slot="sub">
        {/* 曲の補足 (「ミリシタ 1 周年記念楽曲」など)。アプリの曲詳細と同じく曲名の下に 1 文。 */}
        {song.note && <p class="dhead__note">{song.note}</p>}
        {
          song.parentNote && (
            <p class="dhead__note">
              {song.parentNote.before}<a class="u-underline-hover" href={song.parentNote.link.path}>{song.parentNote.link.name}</a>{song.parentNote.after}
            </p>
          )
        }
        {/* 全体曲は 49 人。セトリの行と同じ畳み (ペンライトの棒 + 人数、開けば全員)。 */}
        {
          song.originalArtists.length > 0 && (
            <Fold label="歌唱アイドル" themeKeys={song.originalArtists.map((r) => r.themeKey)}>
              <RefList refs={song.originalArtists} variant="neutral" label="歌唱アイドル" />
            </Fold>
          )
        }
      </Fragment>
      <Fragment slot="badges">
        {song.songTypeLabel && <span class="badge">{song.songTypeLabel}</span>}
        {/* 合同曲はその印を先に。続く札が「参加ブランド」だと読めるようにする。 */}
        {song.collabLabel && <span class="badge">{song.collabLabel}</span>}
        {/* KAMISABI (音楽カードゲーム) の収録札。 */}
        {song.kamisabiLabel && <span class="badge badge--guest">{song.kamisabiLabel}</span>}
        {
          song.brand && (
            <a class="badge badge--themed" data-theme={song.brand.themeKey} href={song.brand.path}>
              {song.brand.name}
            </a>
          )
        }
        {
          song.jointBrands.map((b) => (
            <a class="badge badge--themed" data-theme={b.themeKey} href={b.path}>
              {b.name}
            </a>
          ))
        }
        {
          song.unit && (
            <a class="badge badge--themed" data-theme={song.unit.themeKey} href={song.unit.path}>
              {song.unit.name}
            </a>
          )
        }
        {!song.unit && song.unitLabel && <span class="badge">{song.unitLabel}</span>}
      </Fragment>
      {song.appleMusicUrl && <a class="btn btn--ghost dhead__action" href={song.appleMusicUrl}>Apple Music</a>}
    </DetailHead>
    <StatStrip items={song.statTiles} label="この曲の数" />
  </Fragment>

  {/* 歌詞とコールガイドはこのページの主目的。111 行の披露履歴の下に置くと見つからない。 */}
  <Section id="song-lyrics" title="歌詞とコールガイド">
    <SongLyrics lyrics={song.lyrics} />
  </Section>

  {
    song.factRows.length > 0 && (
      <Section slot="aside" id="song-facts" title="基本情報">
        <ListContainer>
          {song.factRows.map((r) => (
            <LabeledRow
              label={r.label}
              value={r.value}
              href={r.link}
              mono={r.style === "monospaced"}
            />
          ))}
        </ListContainer>
      </Section>
    )
  }

  {
    song.credits.length > 0 && (
      <Section slot="aside" id="song-credits" title="クレジット">
        <ListContainer>
          {song.credits.map((c) => (
            <LabeledRow label={c.role} value={c.display} />
          ))}
        </ListContainer>
      </Section>
    )
  }

  {
    song.otherArtists.length > 0 && (
      <Section slot="aside" id="song-artists" title="ほかに歌ったアイドル">
        <RefList refs={song.otherArtists} variant="neutral" label="ほかに歌ったアイドル" />
      </Section>
    )
  }

  {
    song.variants.length > 0 && (
      <Section slot="aside" id="song-variants" title="派生曲" count={song.variants.length}>
        <RefList refs={song.variants} variant="neutral" label="派生曲" />
      </Section>
    )
  }

  {
    song.related.length > 0 && (
      <Section slot="aside" id="song-related" title="関連する曲">
        <RefList refs={song.related} variant="neutral" label="関連する曲" />
      </Section>
    )
  }

  <Section id="song-history" title="披露履歴" count={song.performanceCount}>
    {
      song.historyEmpty ? (
        <EmptyState {...song.historyEmpty} />
      ) : (
        <ol class="stub-list">
          {song.performanceHistory.map((h) => (
            <li>
              {/* 飛び先は公演ページのその曲の行 (曲順が分からなければ公演の頭)。
                  誰が歌ったかは行の中で言う (セトリを目で探さない)。 */}
              <StubRow
                badge={h.dateBadge}
                title={h.event.name}
                href={h.number > 0 ? `${h.show.path}#${setlistAnchorId(h.number)}` : h.show.path}
                themeKey={h.show.themeKey}
                meta={[h.placeDisplay, h.performersDisplay]}
              >
                <span slot="trailing" class="stub-trail">
                  <span class="stub-trail__label">{h.ordinalLabel}</span>
                  {h.number > 0 && (
                    <span class="num num--medium">
                      {h.number}
                      <span class="num__unit">曲目</span>
                    </span>
                  )}
                </span>
              </StubRow>
            </li>
          ))}
        </ol>
      )
    }
  </Section>

  {
    song.frequentSingers.length > 0 && (
      <Section id="song-singers" title="よく歌うアイドル">
        <ListContainer as="ol">
          {song.frequentSingers.map((s, i) => (
            <li>
              <DetailRow
                rank={i + 1}
                title={s.idol.name}
                sub={s.idol.sub}
                metric={s.times}
                href={s.idol.path}
                themeKey={s.idol.themeKey}
              />
            </li>
          ))}
        </ListContainer>
      </Section>
    )
  }

  {
    song.coOccurring.length > 0 && (
      <Section id="song-cooccur" title="よく一緒に披露される曲">
        <ListContainer as="ol">
          {song.coOccurring.map((c, i) => (
            <li>
              <DetailRow
                rank={i + 1}
                artwork={c.song}
                title={c.song.name}
                sub={c.song.sub}
                metric={c.together}
                href={c.song.path}
                themeKey={c.song.themeKey}
              />
            </li>
          ))}
        </ListContainer>
      </Section>
    )
  }

  {
    song.hasCommunity && (
      <Section id="song-community" title="みんなの記録">
        <div class="card card__pad u-stack">
          <CommunityTags tags={song.community.tags} />
          <p class="community-stats">
            {song.community.favorites > 0 && (
              <span>
                お気に入り <b>{song.community.favorites}</b>
              </span>
            )}
            {song.community.penlight.length > 0 && (
              <span>
                ペンライトの色 <b>{song.community.penlight.length}</b> 通り
              </span>
            )}
          </p>
        </div>
      </Section>
    )
  }

</DetailLayout>
