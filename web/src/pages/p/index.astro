---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { page } from "../../lib/data";
import type { CardCatalog } from "../../lib/schema/CardCatalog";
// 名刺のデザインの書体 (名刺ページだけが読む。ブラウザは名前に出る字の断片だけを取りに行く)。
import "../../styles/card-fonts.css";

/**
 * P名刺 (`/p/`) — このサイトで 2 つ目の、ブラウザ JS で描く島。
 *
 * 名刺の中身 (名前・ひとこと・担当・リンク・公演数) は、QR の URL の `#` の後ろに
 * **全部入っていてサーバには無い** (`https://…/p/#<base64url>`。読んだ側が
 * ブラウザだけで組み立てる形)。だから他の全ページと違って、この HTML はビルド時に
 * 内容を焼き込めない — fragment はリクエストにすら載らないので、Cloudflare にも
 * imas-core にも見えない。`/search/` が「ページを探すための補助」としての例外だった
 * のと同じ理由で、ここも静的に焼けないから JS に頼る例外になる (詳細は
 * `docs/ARCHITECTURE-web.md`)。
 *
 * 読み解き自体は `imas_core::domain::producer_card` を wasm にしたもの
 * (`../../lib/card/decode.ts`) を直接呼ぶので、**ここにも island 側にも名刺の形式判断は
 * 1 行も書かない**。担当アイドル・次の現場の名前・色・URL だけは、id から引く台帳
 * (`p/catalog.json`。今日時点のビルドが出したもの) をこのページが静的に埋め込む。
 */
const catalog = page<CardCatalog>("p/catalog.json");
---

<BaseLayout seo={catalog.seo}>
  {/*
    既定で hidden。JS が無ければこの中は一生出ない (`<noscript>` の案内だけが見える)。
    JS があれば island がこの 1 個の属性を外して「読み取っています…」を見せる。
    CSS でなく HTML 属性にしてあるのは、CSP (style-src 'self') の下でもインライン
    <style> を使わずに同じことができるため。
  */}
  <section class="meishi" data-meishi hidden aria-live="polite">
    <p class="meishi__status" data-meishi-status>名刺を読み取っています…</p>

    {/*
      名刺そのものは 91:55 の横長の紙 1 枚 (アプリの名刺・紙に刷る画像と同じ組み)。表に載せるのは
      名前・P歴・担当 (数で畳む)・ハンドル 1 つ。収まらない詳細は名刺の下の紙面に並べる。
    */}
    <article class="meishi-card" data-meishi-card hidden data-theme="neutral" data-design="pass">
      <div class="meishi-card__band" data-meishi-band aria-hidden="true"></div>
      <div class="meishi-card__body">
        <p class="meishi-card__imprint"><span class="meishi-card__imprint-head"></span><span data-meishi-imprint></span></p>
        <h1 class="meishi-card__name" data-meishi-name></h1>
        <p class="meishi-card__face-oshi" data-meishi-face-oshi hidden></p>
        <p class="meishi-card__footer">
          <span class="meishi-card__handle" data-meishi-handle></span>
          <span class="meishi-card__brand">IDOL LIVE DB</span>
        </p>
      </div>
    </article>

    <div class="meishi-details" data-meishi-details hidden>
      <p class="meishi-details__message" data-meishi-message></p>
      <p class="meishi-details__since" data-meishi-since hidden></p>

      <section class="section" data-meishi-oshi-section aria-labelledby="meishi-oshi-title">
        <div class="section__head"><h2 class="section__title" id="meishi-oshi-title">担当</h2></div>
        <ul class="meishi-details__oshi" data-meishi-oshi></ul>
      </section>

      <section class="section" data-meishi-links-section aria-labelledby="meishi-links-title">
        <div class="section__head"><h2 class="section__title" id="meishi-links-title">リンク</h2></div>
        <ul class="meishi-details__links" data-meishi-links></ul>
      </section>

      <div class="meishi-details__board" data-meishi-board aria-label="記録">
        <div class="meishi-details__digit">
          <span class="meishi-details__digit-value" data-meishi-show-count>0</span>
          <span class="meishi-details__digit-label">参加公演</span>
        </div>
        <div class="meishi-details__digit">
          <span class="meishi-details__digit-value" data-meishi-song-count>0</span>
          <span class="meishi-details__digit-label">回収曲</span>
        </div>
        <p class="meishi-details__next" data-meishi-next hidden></p>
      </div>

      <p class="meishi-details__asof" data-meishi-asof></p>
    </div>

    <div class="open-in-app" data-meishi-case hidden aria-label="アプリで開く">
      <img
        class="open-in-app__icon"
        src="/icon-192.png"
        alt=""
        width="48"
        height="48"
        loading="lazy"
        decoding="async"
      />
      <div class="open-in-app__body">
        <p class="open-in-app__title">{catalog.appOpenTitle}</p>
        <p class="open-in-app__note" data-meishi-case-note>{catalog.appOpenNote}</p>
      </div>
      <div class="open-in-app__actions">
        <a class="btn" data-meishi-case-scheme href={catalog.appStoreUrl}>アプリで開く</a>
        <a class="btn btn--ghost" href={catalog.appStoreUrl}>App Store</a>
      </div>
    </div>

    <p class="meishi__status" data-meishi-unreadable hidden>{catalog.unreadableText}</p>
  </section>

  <noscript>
    <div class="open-in-app" aria-label="アプリで開く">
      <img
        class="open-in-app__icon"
        src="/icon-192.png"
        alt=""
        width="48"
        height="48"
        loading="lazy"
        decoding="async"
      />
      <div class="open-in-app__body">
        <p class="open-in-app__title">{catalog.appOpenTitle}</p>
        <p class="open-in-app__note">
          JavaScript が無効なため、ここでは名刺を表示できません。{catalog.appOpenNote}
        </p>
      </div>
      <div class="open-in-app__actions">
        <a class="btn" href={catalog.appStoreUrl}>App Store</a>
      </div>
    </div>
  </noscript>
</BaseLayout>

<script>
  import "../../lib/card/island";
</script>
