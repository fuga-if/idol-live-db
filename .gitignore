# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
build/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# macOS
.DS_Store
*.swp
*~

# SQLite generated
ImasLiveDB/Resources/master.sqlite
# Android: db/master.sql からビルド時生成する seed (generateSeedDb タスク)
ImasLiveDB-Android/app/src/main/assets/master_seed.sqlite

# Secrets
.env
.dev.vars
imas-live-api/.dev.vars
.wrangler/
eckey.pem
firebase-debug.log
imas-live-api/node_modules/

# Claude Code ランタイム状態
.claude/scheduled_tasks.lock

# ASC API の Issuer/Key ID を含む個人用スキル (本人のみ使用・公開不要)
.claude/skills/submit-to-appstore/

# Contains personal info (phone/email) used only locally and via CI Secrets
fastlane/metadata/review_information/

# fastlane signing artifacts (regenerated as needed)
*.mobileprovision
*.certSigningRequest
*.cer
*.p12
*.ipa
fastlane/report.xml
fastlane/README.md
*.sqlite.bak*
*.sqlite-shm
*.sqlite-wal

# データ更新時の DB バックアップ退避先 (バンドル対象外・ローカルのみ)
db_backups_local/

# Firebase iOS 設定 (非公開・各自配置。analytics は無くても動作)
ImasLiveDB/Resources/GoogleService-Info.plist
# XcodeBuildMCP のマシン固有設定 (絶対パス/シミュレータ UUID)
.xcodebuildmcp/
# ルートの空 master プレースホルダ
/master.sqlite

# Firebase Android 設定 (未使用の dead config・各自配置)
ImasLiveDB-Android/app/google-services.json
google-services.json

# fastlane/ruby (fastlane はローカル専用化済み・各自保持)
Gemfile
Gemfile.lock
.ruby-version

# AI エージェント用の作業ガイド (ローカル管理・追跡外)
CLAUDE.md

# xcodegen/実行時に生成される空の作業用 DB (正は db/master.sql)
db/master.sqlite

# JASRAC 提出物の生成物 (許諾番号を含むので追跡しない)
tools/jasrac/out/

# 歌詞の作業場。JASRAC 許諾は「一括ダウンロードできない形での配信」が条件なので
# 歌詞本文は公開リポジトリに絶対に入れない。
/lyrics_local/
tools/lyrics/node_modules
# 照合レポート。歌詞本文の抜粋が載るので公開リポジトリに入れない
tools/lyrics/out/

# imas-core (Rust) のビルド生成物。imas-core/build.sh が再生成する
imas-core/target/
# imas-text-fold (畳み込み規則の crate) のビルド生成物
imas-text-fold/target/
# tools/ の Python スクリプトを import/実行したときに出るバイトコード
__pycache__/
*.pyc

# 読み突き合わせの作業ファイル (再生成できる。state は途中再開用)
tools/readings/crosscheck.tsv
tools/readings/crosscheck_state.json

# Web 出面 (web/) のビルド生成物。web-export bin / astro build / wasm-pack が再生成する。
# web/data-fixture/ と web/src/lib/schema/ は commit 対象 (生成物だが正として扱う) なので含めない。
web/data/
web/.cache/
web/dist/
web/src/lib/fold/
web/node_modules/
web/wasm/*/target/
web/wasm/*/pkg/

# 並列エージェント用の共有 cargo ビルドキャッシュ (数GB)
target-shared/
