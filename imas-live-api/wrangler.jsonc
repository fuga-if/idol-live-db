{
  "name": "imas-live-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imas-live-db",
      "database_id": "853e9879-df05-49f6-b215-e5ec1a6c0d6b"
    }
  ],
  "vars": {
    "APPLE_BUNDLE_ID": "com.fugaif.ImasLiveDB",
    // ALLOWED_ORIGINS: Web フロントエンドの Origin をカンマ区切りで列挙。
    // iOS ネイティブは Origin ヘッダを送らないため、空文字列でも動作する。
    // 例: "https://yourapp.example.com,https://admin.example.com"
    "ALLOWED_ORIGINS": "",
    // Android Sign in with Google (Credential Manager) の ID トークン検証用 aud。
    // 秘密情報ではない (公開して問題ない値) ので vars でよい。クライアントシークレットは
    // ID トークン署名検証方式では不要なため一切保持しない。
    "GOOGLE_WEB_CLIENT_ID": "612236234738-q1ku8tnnf4ce9jm1q006jp45k6mmmluc.apps.googleusercontent.com"
  },
  // Workers Logs。歌詞の利用ログ (event=lyrics_read) を拾う唯一の経路なので、
  // sampling は 1 (間引くと JASRAC 報告のリクエスト回数が実数より少なくなる)。
  // 保持期間は無料プランで 3 日なので、日次バッチが 3 日以上止まるとその分は
  // 取り返せない (docs/JASRAC.md「リクエスト回数の集計」)。
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // CLOUDKIT_KEY_ID and CLOUDKIT_PRIVATE_KEY are set via wrangler secret
  "triggers": {
    // "*/5 * * * *": インデックスの効いた軽い掃除 (api_rate_limits / transfer_codes)。
    // "17 15 * * *": 重い掃除 (rate_limits の 7 日超削除)。日次で十分なので分けてある。
    //                src/index.ts の DAILY_CRON と必ず一致させること。
    "crons": ["*/5 * * * *", "17 15 * * *"]
  }
}
